---
const items = ['Work', 'Services', 'Process', 'About', 'Contact'];
const path = Astro.url.pathname;
---
<header class="studio-nav">
 <a class="studio-wordmark" href="/" aria-label="Algoryxz home">ALGORYXZ<span aria-hidden="true">↗</span></a>
 <nav aria-label="Main navigation">{items.map(item => <a href={`/${item.toLowerCase()}`} aria-current={path.startsWith(`/${item.toLowerCase()}`) ? 'page' : undefined}>{item}</a>)}</nav>
</header>
<style>
.studio-nav{position:relative;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:20px 3.4vw;background:#10100f;color:#eee9df;border-bottom:1px solid #ffffff15}.studio-wordmark{font-size:21px;font-weight:800;letter-spacing:-.055em;display:flex;align-items:center;gap:15px}.studio-wordmark span{color:#ba7047;font-weight:400}nav{display:flex;gap:32px}nav a{display:flex;align-items:center;min-height:44px;font-size:13px;position:relative}nav a[aria-current],nav a:hover{color:#e7a37b}nav a[aria-current]::after{content:'';position:absolute;bottom:4px;width:14px;height:1px;background:currentColor}@media(max-width:600px){.studio-nav{padding:15px 20px 8px;flex-wrap:wrap;gap:3px}.studio-wordmark{font-size:20px}nav{width:100%;justify-content:space-between;gap:10px}nav a{font-size:12px}}
</style>
