---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-primary">
      <div class="footer-brand">
        <a href="/" class="brand-link">
          <span class="brand-name">ALGORYXZ</span>
          <span class="brand-tag">/ 000</span>
        </a>
        <p class="footer-desc">
          AI-native digital studio engineered by Smarak, Deeptiman, and Akriti. Delivering high-craft digital experiences across Celebrations, Business & Brand, and Custom Systems.
        </p>
      </div>

      <div class="footer-nav-grid">
        <div class="footer-column">
          <h4 class="footer-heading">Studio</h4>
          <ul class="footer-list">
            <li><a href="/work">Selected Work</a></li>
            <li><a href="/services">Services & Lanes</a></li>
            <li><a href="/process">How We Work</a></li>
            <li><a href="/about">Founders</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4 class="footer-heading">Operational Lanes</h4>
          <ul class="footer-list">
            <li><a href="/services#celebrations">Celebrations</a></li>
            <li><a href="/services#business">Business & Brand</a></li>
            <li><a href="/services#custom">Custom Systems</a></li>
            <li><a href="/services#care">Care Plans</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4 class="footer-heading">Inquiries</h4>
          <ul class="footer-list">
            <li><a href="/contact">Start a Project</a></li>
            <li><span class="location-badge">Bhubaneswar, Odisha</span></li>
            <li><span class="meta-note">[Operating Contract V1 Governed]</span></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} Algoryxz. All rights reserved. Zero client assets held hostage.
      </p>
      <div class="footer-meta">
        <span class="meta-pill">Static Edge Build</span>
        <span class="meta-pill">Cloudflare Pages</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-surface);
    border-top: 1px solid var(--color-border-hairline);
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }

  .footer-primary {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .footer-brand {
    max-width: 380px;
  }

  .brand-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-family-mono);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .brand-tag {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .footer-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  .footer-heading {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-list a {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .footer-list a:hover {
    color: var(--color-text-primary);
  }

  .location-badge,
  .meta-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-8);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .footer-meta {
    display: flex;
    gap: var(--space-2);
  }

  .meta-pill {
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-canvas);
    border: 1px solid var(--color-border-hairline);
    font-family: var(--font-family-mono);
  }

  @media (min-width: 768px) {
    .footer-primary {
      grid-template-columns: 1.5fr 2fr;
    }

    .footer-nav-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
