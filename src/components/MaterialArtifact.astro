---
interface Props { kind: 'structure' | 'someone' | 'business'; }
const { kind } = Astro.props;
---
<div class:list={['material-artifact', `artifact-${kind}`]} aria-hidden="true">
 {kind === 'structure' && <><div class="drawing-axis"></div><img class="structure-print" src="/assets/structure.svg" alt=""/><span class="artifact-mark">XZ / STUDY OF A FOLD</span></>}
 {kind === 'someone' && <><div class="memory-paper"><span>keep this feeling.</span><small>A PLACE FOR ALL THE LITTLE THINGS.</small></div><figure class="memory-photo"><img src="/assets/lab/monsoon_vows_memory.jpg" alt="" loading="lazy"/><figcaption>after the rain —</figcaption></figure><span class="memory-line">a day. a lifetime.</span></>}
 {kind === 'business' && <><div class="print-sheet"><small>IDENTITY / PRINT / DIGITAL</small><strong>FORM<br/>FOLLOWS<br/><i>FEELING.</i></strong><div class="print-bars"></div><span>AN ALGORYXZ MATERIAL STUDY</span></div><div class="print-spine">MAKE YOUR MARK.</div><div class="print-label">Aa<span>0123456789<br/>TYPE / MATTER</span></div></>}
</div>
<style>
.material-artifact{position:relative;width:100%;height:100%;container-type:inline-size}.structure-print{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 35px 25px #0008)}.artifact-mark{position:absolute;bottom:7%;left:20%;font:9px monospace;letter-spacing:.12em;color:#9b9286}.drawing-axis{position:absolute;inset:18%;border:1px solid #bb9b7530;transform:rotate(-35deg)}.drawing-axis::after{content:'';position:absolute;inset:20% -25%;border-top:1px solid #bb9b7530;border-bottom:1px solid #bb9b7530}
.memory-paper{position:absolute;width:72%;height:72%;background:#e6d6b7;color:#5b3827;right:0;top:5%;transform:rotate(10deg);box-shadow:12px 20px 40px #0005;padding:9%;display:flex;flex-direction:column;justify-content:space-between}.memory-paper span{font:italic clamp(12px,10cqw,48px) Georgia,serif}.memory-paper small{font:8px monospace;letter-spacing:.12em}.memory-photo{position:absolute;width:73%;height:78%;left:0;bottom:0;padding:10px 10px 35px;background:#eae1d0;transform:rotate(-8deg);box-shadow:0 22px 45px #0006}.memory-photo img{width:100%;height:100%;object-fit:cover;filter:sepia(.55) saturate(.45)}.memory-photo figcaption{font:italic 14px Georgia,serif;color:#5a4632;margin:5px}.memory-line{position:absolute;bottom:4%;right:-3%;font:italic clamp(10px,9cqw,45px) Georgia,serif;color:#ead9bd;transform:rotate(-12deg);text-shadow:0 2px 20px #000}
.print-sheet{position:absolute;inset:0 14% 12% 0;background:#d4d5bd;color:#20241c;padding:7%;transform:rotate(-9deg);box-shadow:0 25px 50px #0006;display:flex;flex-direction:column;justify-content:space-between}.print-sheet small,.print-sheet>span{font:8px monospace;letter-spacing:.1em}.print-sheet strong{font-size:clamp(14px,13cqw,75px);line-height:.88;letter-spacing:-.07em}.print-sheet i{font-family:Georgia,serif;font-weight:400}.print-bars{height:10%;background:repeating-linear-gradient(90deg,#20241c 0 2px,transparent 2px 7px)}.print-spine{position:absolute;right:0;top:5%;width:21%;height:91%;writing-mode:vertical-rl;white-space:nowrap;background:#ba5031;color:#1d1c17;padding:12% 3%;font-size:clamp(12px,7cqw,40px);font-weight:700;letter-spacing:-.05em;transform:rotate(8deg);box-shadow:0 20px 30px #0005}.print-label{position:absolute;right:3%;bottom:-3%;width:45%;background:#ece7dc;color:#24291e;padding:4% 7%;transform:rotate(7deg);font:clamp(20px,18cqw,85px) Georgia,serif;box-shadow:0 10px 30px #0003}.print-label span{display:block;font:8px monospace}
@container(max-width:180px){.memory-photo{padding:4px 4px 15px}.memory-photo figcaption{font-size:6px;margin:3px}.memory-paper small,.print-sheet small,.print-sheet>span,.print-label span{font-size:3px}.artifact-mark{font-size:4px}.memory-line{bottom:7%}}
</style>

