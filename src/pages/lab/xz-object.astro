</style>

<script>
  import * as THREE from 'three';

  // --- CLIENT RUNTIME INITIALIZATION ---
  function initXZObjectExperience() {
    const container = document.getElementById('webgl-canvas-container');
    if (!container) return;

    // Check query params for debug mode
    const urlParams = new URLSearchParams(window.location.search);
    const isDebug = urlParams.get('debug') === '1';
    const debugHud = document.getElementById('dev-debug-hud');
    if (isDebug && debugHud) {
      debugHud.style.display = 'block';
    }

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Scene, Camera, Renderer Setup
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0d0e11, 0.04);

    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
    camera.position.set(0, 0, 14);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;
    container.appendChild(renderer.domElement);

    // 2. Lighting System
    const ambientLight = new THREE.AmbientLight(0x0d0e11, 1.8);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xf09848, 3.2);
    keyLight.position.set(6, 8, 8);
    keyLight.castShadow = true;
    keyLight.shadow.mapSize.width = 1024;
    keyLight.shadow.mapSize.height = 1024;
    scene.add(keyLight);

    const coolRimLight = new THREE.DirectionalLight(0x6b8299, 1.8);
    coolRimLight.position.set(-8, -4, -6);
    scene.add(coolRimLight);

    const coreLight = new THREE.PointLight(0xd97736, 4.0, 16);
    coreLight.position.set(0, 0, 0);
    scene.add(coreLight);

    // 3. Materials
    const darkCharcoalMat = new THREE.MeshStandardMaterial({
      color: 0x14161a,
      roughness: 0.35,
      metalness: 0.25,
      side: THREE.DoubleSide
    });

    const bronzeEdgeMat = new THREE.MeshStandardMaterial({
      color: 0xd97736,
      roughness: 0.3,
      metalness: 0.75,
      emissive: 0x221105,
      side: THREE.DoubleSide
    });

    const translucentResinMat = new THREE.MeshPhysicalMaterial({
      color: 0x242830,
      roughness: 0.18,
      transmission: 0.65,
      thickness: 1.5,
      ior: 1.45,
      transparent: true,
      opacity: 0.85,
      side: THREE.DoubleSide
    });

    // 4. Procedural XZ Sculpture Hierarchy
    const xzMasterGroup = new THREE.Group();
    scene.add(xzMasterGroup);

    // Sub-Groups for transformations
    const fragment000 = new THREE.Group(); // Left plate (Internal)
    const fragment001 = new THREE.Group(); // Center plate (Celebration Heirloom)
    const fragment002 = new THREE.Group(); // Right plate (Brand)
    const outerPlanesGroup = new THREE.Group(); // Outer deconstructing petals

    xzMasterGroup.add(fragment000);
    xzMasterGroup.add(fragment001);
    xzMasterGroup.add(fragment002);
    xzMasterGroup.add(outerPlanesGroup);

    // Helper: Extruded Trajectory Slabs (encoding crossing X & Z diagonals)
    function createTrapezoidSlab(w1: number, w2: number, h: number, depth: number, material: THREE.Material) {
      const shape = new THREE.Shape();
      shape.moveTo(-w1 / 2, -h / 2);
      shape.lineTo(w1 / 2, -h / 2);
      shape.lineTo(w2 / 2, h / 2);
      shape.lineTo(-w2 / 2, h / 2);
      shape.closePath();

      const extrudeSettings = {
        depth: depth,
        bevelEnabled: true,
        bevelSegments: 3,
        steps: 1,
        bevelSize: 0.05,
        bevelThickness: 0.05
      };
      const geom = new THREE.ExtrudeGeometry(shape, extrudeSettings);
      geom.center();
      const mesh = new THREE.Mesh(geom, material);
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      return mesh;
    }

    // Populate Fragment /001 (Center Dominant)
    const slab001 = createTrapezoidSlab(3.6, 2.8, 4.8, 0.25, translucentResinMat);
    const trim001 = createTrapezoidSlab(3.65, 2.85, 4.85, 0.05, bronzeEdgeMat);
    trim001.position.z = -0.15;
    fragment001.add(slab001);
    fragment001.add(trim001);

    // Populate Fragment /000 (Left)
    const slab000 = createTrapezoidSlab(2.8, 2.0, 3.8, 0.2, darkCharcoalMat);
    slab000.rotation.set(0.1, 0.25, -0.15);
    fragment000.add(slab000);

    // Populate Fragment /002 (Right)
    const slab002 = createTrapezoidSlab(2.8, 2.0, 3.8, 0.2, darkCharcoalMat);
    slab002.rotation.set(-0.1, -0.25, 0.15);
    fragment002.add(slab002);

    // Outer crossing diagonals encoding X & Z tension
    const outerPlane1 = createTrapezoidSlab(4.2, 1.2, 2.4, 0.1, darkCharcoalMat);
    outerPlane1.position.set(-1.2, 1.4, 0.6);
    outerPlane1.rotation.set(0.3, 0.4, 0.6);
    outerPlanesGroup.add(outerPlane1);

    const outerPlane2 = createTrapezoidSlab(1.2, 4.2, 2.4, 0.1, darkCharcoalMat);
    outerPlane2.position.set(1.2, -1.4, -0.6);
    outerPlane2.rotation.set(-0.3, -0.4, -0.6);
    outerPlanesGroup.add(outerPlane2);

    // 5. Interaction State Variables
    let scrollProgress = 0;
    let targetProgress = 0;
    let isClientWorldOpen = false;

    let mouseX = 0;
    let mouseY = 0;
    let targetRotX = 0;
    let targetRotY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;

    // 6. DOM Elements
    const lineWeMake = document.getElementById('line-we-make');
    const lineForInternet = document.getElementById('line-for-internet');
    const clientWorldOverlay = document.getElementById('client-world-overlay');
    const thresholdBarFill = document.getElementById('threshold-bar-fill');
    const acousticPlayer = document.getElementById('acoustic-player');
    const playerToggleBtn = document.getElementById('player-toggle-btn');
    const iconPlay = playerToggleBtn?.querySelector('.icon-play') as HTMLElement;
    const iconPause = playerToggleBtn?.querySelector('.icon-pause') as HTMLElement;

    // 7. Scroll Listener
    function updateScrollProgress() {
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      if (maxScroll > 0) {
        targetProgress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
      }
    }

    window.addEventListener('scroll', updateScrollProgress, { passive: true });
    updateScrollProgress();

    // 8. Pointer / Drag Handling
    window.addEventListener('pointermove', (e) => {
      const normX = (e.clientX / window.innerWidth) * 2 - 1;
      const normY = -(e.clientY / window.innerHeight) * 2 + 1;
      mouseX = normX;
      mouseY = normY;

      if (isDragging) {
        const deltaX = e.clientX - dragStartX;
        const deltaY = e.clientY - dragStartY;
        targetRotY += deltaX * 0.003;
        targetRotX += deltaY * 0.003;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
      }
    });

    window.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement)?.closest('button, a, input, .client-world-overlay')) return;
      isDragging = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
    });

    window.addEventListener('pointerup', () => {
      isDragging = false;
    });

    // 9. Interactive Fragment Triggers & Navigation
    function openClientWorld() {
      isClientWorldOpen = true;
      clientWorldOverlay?.classList.add('active');
      clientWorldOverlay?.setAttribute('aria-hidden', 'false');
    }

    function closeClientWorld() {
      isClientWorldOpen = false;
      clientWorldOverlay?.classList.remove('active');
      clientWorldOverlay?.setAttribute('aria-hidden', 'true');
    }

    document.getElementById('card-frag-001')?.addEventListener('click', () => {
      openClientWorld();
    });

    document.getElementById('btn-enter-world-direct')?.addEventListener('click', () => {
      openClientWorld();
    });

    document.getElementById('btn-return-studio')?.addEventListener('click', () => {
      closeClientWorld();
    });

    document.getElementById('btn-explore-scroll')?.addEventListener('click', () => {
      window.scrollTo({ top: window.innerHeight * 1.5, behavior: 'smooth' });
    });

    // Audio Playback Simulation
    let isPlaying = false;
    playerToggleBtn?.addEventListener('click', () => {
      isPlaying = !isPlaying;
      if (isPlaying) {
        acousticPlayer?.classList.add('playing');
        if (iconPlay) iconPlay.style.display = 'none';
        if (iconPause) iconPause.style.display = 'block';
      } else {
        acousticPlayer?.classList.remove('playing');
        if (iconPlay) iconPlay.style.display = 'block';
        if (iconPause) iconPause.style.display = 'none';
      }
    });

    // Wax Seal Blessing Interaction
    const btnWaxSeal = document.getElementById('btn-wax-seal');
    const sealStatus = document.getElementById('seal-status');
    let blessingCount = 48;
    btnWaxSeal?.addEventListener('click', () => {
      blessingCount++;
      if (sealStatus) {
        sealStatus.textContent = `✨ Your blessing sealed into archive ledger. (${blessingCount} blessings immortalized)`;
        sealStatus.style.color = 'var(--color-studio-amber)';
      }
    });

    // Keyboard ESC to close
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isClientWorldOpen) {
        closeClientWorld();
      }
    });

    // 10. Debug HUD Controls
    if (isDebug) {
      const debugScrub = document.getElementById('debug-scrub') as HTMLInputElement;
      const debugProgVal = document.getElementById('debug-prog-val');
      const btnCloseDebug = document.getElementById('btn-close-debug');
      const btnToggleWire = document.getElementById('dbg-toggle-wireframe');
      const btnResetCam = document.getElementById('dbg-reset-cam');

      btnCloseDebug?.addEventListener('click', () => {
        if (debugHud) debugHud.style.display = 'none';
      });

      debugScrub?.addEventListener('input', (e) => {
        const val = parseFloat((e.target as HTMLInputElement).value) / 100;
        targetProgress = val;
        if (debugProgVal) debugProgVal.textContent = `${Math.round(val * 100)}%`;
      });

      document.querySelectorAll('[data-target-stage]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const stage = parseFloat((e.target as HTMLElement).dataset.targetStage || '0');
          targetProgress = stage;
          if (debugScrub) debugScrub.value = `${stage * 100}`;
          if (debugProgVal) debugProgVal.textContent = `${Math.round(stage * 100)}%`;
        });
      });

      let isWireframe = false;
      btnToggleWire?.addEventListener('click', () => {
        isWireframe = !isWireframe;
        darkCharcoalMat.wireframe = isWireframe;
        bronzeEdgeMat.wireframe = isWireframe;
        translucentResinMat.wireframe = isWireframe;
      });

      btnResetCam?.addEventListener('click', () => {
        targetRotX = 0;
        targetRotY = 0;
      });
    }

    // 11. Main Render & Choreography Loop
    let lastTime = performance.now();
    let frameCount = 0;
    let fps = 60;

    function animate(currentTime: number) {
      requestAnimationFrame(animate);

      const delta = (currentTime - lastTime) / 1000;
      lastTime = currentTime;
      frameCount++;
      if (frameCount % 30 === 0) {
        fps = Math.round(1 / delta);
        const dbgFps = document.getElementById('dbg-fps');
        if (dbgFps) dbgFps.textContent = `${fps}`;
      }

      // Smooth progress lerp
      scrollProgress += (targetProgress - scrollProgress) * (prefersReducedMotion ? 0.3 : 0.08);

      // DOM Parallax on Typography
      if (lineWeMake && lineForInternet) {
        const p = scrollProgress;
        lineWeMake.style.transform = `translate3d(${p * 40}px, ${-p * 60}px, ${p * 120}px)`;
        lineForInternet.style.transform = `translate3d(${-p * 30}px, ${p * 40}px, ${-p * 100}px)`;
        lineForInternet.style.opacity = `${Math.max(0.2, 1 - p * 1.4)}`;
      }

      // Update Threshold Progress Bar
      if (thresholdBarFill) {
        const thresholdPercent = Math.min(100, Math.max(0, (scrollProgress - 0.6) * 250));
        thresholdBarFill.style.width = `${thresholdPercent}%`;
      }

      // === 3D GEOMETRY & CAMERA CHOREOGRAPHY ===
      const p = isClientWorldOpen ? 1.0 : scrollProgress;

      // Master rotation & pointer tilt
      const targetBaseY = p * 1.2 + mouseX * 0.15;
      const targetBaseX = mouseY * 0.15;
      xzMasterGroup.rotation.y += (targetBaseY + targetRotY - xzMasterGroup.rotation.y) * 0.06;
      xzMasterGroup.rotation.x += (targetBaseX + targetRotX - xzMasterGroup.rotation.x) * 0.06;

      // 1. Stage D01 -> D02: Object Opening
      const openFactor = Math.min(1, Math.max(0, (p - 0.15) / 0.35));
      outerPlane1.position.x = -1.2 - openFactor * 2.5;
      outerPlane1.position.z = 0.6 + openFactor * 1.8;
      outerPlane1.rotation.y = 0.4 + openFactor * 0.8;

      outerPlane2.position.x = 1.2 + openFactor * 2.5;
      outerPlane2.position.z = -0.6 - openFactor * 1.8;
      outerPlane2.rotation.y = -0.4 - openFactor * 0.8;

      coreLight.intensity = 2.0 + openFactor * 4.0;

      // 2. Stage D02 -> D03: Fragments align as archive
      const archiveFactor = Math.min(1, Math.max(0, (p - 0.45) / 0.3));
      fragment000.position.x = -archiveFactor * 4.2;
      fragment000.position.z = -archiveFactor * 1.5;
      fragment000.rotation.y = archiveFactor * 0.35;

      fragment002.position.x = archiveFactor * 4.2;
      fragment002.position.z = -archiveFactor * 1.8;
      fragment002.rotation.y = -archiveFactor * 0.35;

      // 3. Stage D03 -> D04 -> D05: Fragment 001 surges toward camera
      const surgeFactor = Math.min(1, Math.max(0, (p - 0.7) / 0.3));
      fragment001.position.z = archiveFactor * 1.5 + surgeFactor * 6.5;
      fragment001.position.x = surgeFactor * 1.8;
      fragment001.scale.setScalar(1.0 + surgeFactor * 0.6);

      // Camera position interpolation
      const targetCamZ = 14 - p * 7.5;
      const targetCamY = -p * 1.5;
      camera.position.z += (targetCamZ - camera.position.z) * 0.06;
      camera.position.y += (targetCamY - camera.position.y) * 0.06;

      // Telemetry updates for Dev HUD
      if (isDebug) {
        const dbgCamPos = document.getElementById('dbg-cam-pos');
        const dbgObjRot = document.getElementById('dbg-obj-rot');
        if (dbgCamPos) dbgCamPos.textContent = `${camera.position.x.toFixed(1)}, ${camera.position.y.toFixed(1)}, ${camera.position.z.toFixed(1)}`;
        if (dbgObjRot) dbgObjRot.textContent = `${Math.round(xzMasterGroup.rotation.x * 57.3)}°, ${Math.round(xzMasterGroup.rotation.y * 57.3)}°`;
      }

      renderer.render(scene, camera);
    }

    requestAnimationFrame(animate);

    // 12. Window Resize Handling
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  }

  // Execute on DOM Ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initXZObjectExperience);
  } else {
    initXZObjectExperience();
  }
</script>
