---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Revision 03 — Signature Spatial Architecture" 
  description="Algoryxz Revision 03 Spatial Backbone: Procedural XZ sculpture, scroll unfurl, archive emergence, and /001 living memory portal."
>
  <div class="r03-container" id="r03-root">
    <!-- Recessive Studio Spatial Header (Unboxed, Minimal Chrome) -->
    <header class="r03-studio-header" id="studio-header">
      <div class="header-inner">
        <a href="/" class="studio-brand">
          <span class="brand-text">ALGORYXZ</span>
          <span class="brand-sub">STUDIO</span>
        </a>
        
        <div class="header-coords">
          <span class="coord-item">REVISION 03</span>
          <span class="coord-sep">/</span>
          <span class="coord-item coord-active" id="header-stage-indicator">STAGE A // ARRIVAL</span>
        </div>

        <nav class="header-nav" aria-label="Studio quick navigation">
          <a href="/work" class="nav-link">WORK</a>
          <a href="/services" class="nav-link">SERVICES</a>
          <a href="/process" class="nav-link">PROCESS</a>
          <a href="/contact" class="nav-link nav-link-cta">CONTACT</a>
        </nav>
      </div>
    </header>

    <!-- Fullscreen Three.js WebGL Viewport -->
    <div id="r03-webgl-canvas" class="r03-webgl-canvas" aria-hidden="true"></div>

    <!-- Continuous Spatial Scroll Track (420vh physical timeline) -->
    <div class="spatial-scroll-track" id="spatial-scroll-track">
      
      <!-- STAGE A: ARRIVAL (0vh - 100vh) -->
      <section class="spatial-stage stage-arrival" id="stage-arrival" data-stage="arrival">
        <div class="stage-shell arrival-shell">
          <div class="hero-typographic-core" id="hero-typo-core">
            <div class="kicker-quiet">
              <span class="kicker-dot"></span>
              <span class="kicker-text">AI-NATIVE DIGITAL ATELIER</span>
            </div>
            <h1 class="hero-headline" id="hero-headline">
              <span class="line line-1">WE MAKE</span>
              <span class="line line-2">THINGS FOR</span>
              <span class="line line-3">THE INTERNET.</span>
            </h1>
            <p class="hero-manifesto" id="hero-manifesto">
              For businesses with something to say, people celebrating something that matters, and ideas that don't fit inside a template.
            </p>
          </div>

          <div class="arrival-footer-affordance" id="arrival-affordance">
            <div class="scroll-instruction">
              <span class="scroll-chevron-track">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
                </svg>
              </span>
              <span class="scroll-instruction-text">SCROLL TO UNFURL XZ ARCHITECTURE</span>
            </div>
          </div>
        </div>
      </section>

      <!-- STAGE B: XZ UNFURL (100vh - 220vh) -->
      <section class="spatial-stage stage-unfurl" id="stage-unfurl" data-stage="unfurl">
        <div class="stage-shell unfurl-shell">
          <!-- Physical Event Subtitles / Micro-telemetry -->
          <div class="unfurl-annotation" id="unfurl-annotation">
            <span class="annotation-tag">CORE UNLOCK // TANGENT RELEASE</span>
            <p class="annotation-text">Opposing diagonals shear along stepped Z planes, revealing internal mineral light seams.</p>
          </div>
        </div>
      </section>

      <!-- STAGE C: ARCHIVE EMERGENCE (220vh - 340vh) -->
      <section class="spatial-stage stage-archive" id="stage-archive" data-stage="archive">
        <div class="stage-shell archive-shell">
          <div class="archive-editorial-header">
            <span class="archive-kicker">ALGORYXZ // SPATIAL ARCHIVE</span>
            <h2 class="archive-title">The folded structure yields three distinct fragments.</h2>
            <p class="archive-guide">Pointer tilts perspective. Tab or click to engage the portal.</p>
          </div>

          <div class="archive-fragments-grid" role="list">
            <!-- Fragment 000: Studio Engine -->
            <button 
              type="button" 
              class="fragment-spatial-anchor anchor-000" 
              id="anchor-frag-000" 
              data-fragment="000"
              role="listitem"
              aria-label="Inspect Algoryxz 000 Studio Engine"
            >
              <div class="anchor-meta">
                <span class="anchor-id">000</span>
                <span class="anchor-domain">INTERNAL</span>
              </div>
              <h3 class="anchor-name">Studio Engine</h3>
              <p class="anchor-desc">Zero-bloat semantic runtime and foundational framework for bespoke client environments.</p>
              <span class="anchor-action">
                <span>INSPECT RUNTIME</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </button>

            <!-- Fragment 001: Living Memory (Featured Heirloom Concept) -->
            <button 
              type="button" 
              class="fragment-spatial-anchor anchor-001 anchor-dominant" 
              id="anchor-frag-001" 
              data-fragment="001"
              role="listitem"
              aria-label="Enter Algoryxz 001 The Monsoon Vows celebration portal"
            >
              <div class="anchor-badge-highlight">DOMINANT PORTAL</div>
              <div class="anchor-meta">
                <span class="anchor-id anchor-id-amber">001</span>
                <span class="anchor-domain">FOR SOMEONE</span>
              </div>
              <h3 class="anchor-name">The Monsoon Vows</h3>
              <p class="anchor-desc">An intimate digital sanctuary holding spoken vows, acoustic reels, and medium-format memories under Western Ghats rain.</p>
              <span class="anchor-action anchor-action-amber">
                <span>ENTER PORTAL THRESHOLD</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </button>

            <!-- Fragment 002: Brand Flagship -->
            <button 
              type="button" 
              class="fragment-spatial-anchor anchor-002" 
              id="anchor-frag-002" 
              data-fragment="002"
              role="listitem"
              aria-label="Explore Algoryxz 002 Craft Flagship"
            >
              <div class="anchor-meta">
                <span class="anchor-id">002</span>
                <span class="anchor-domain">FOR A BUSINESS</span>
              </div>
              <h3 class="anchor-name">Craft Flagship</h3>
              <p class="anchor-desc">Tactile digital experience for artisanal coffee roasters and bespoke design ateliers.</p>
              <span class="anchor-action">
                <span>EXPLORE CRAFT</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </button>
          </div>
        </div>
      </section>

      <!-- STAGE D: PORTAL TRANSITION CONTEXT (340vh - 420vh) -->
      <section class="spatial-stage stage-portal" id="stage-portal" data-stage="portal">
        <div class="stage-shell portal-shell">
          <div class="portal-kicker-block">
            <span class="portal-counter">TRANSITIONING MATERIAL</span>
            <p class="portal-phrase">Algoryxz provides the structure. Client memory becomes the world.</p>
          </div>
        </div>
      </section>
    </div>

    <!-- STAGE E: CLIENT WORLD THRESHOLD (THE MONSOON VOWS) -->
    <div class="client-world-viewport" id="client-world-viewport" aria-hidden="true">
      <!-- Background Memory Canvas with Vignette -->
      <div class="world-scenic-layer">
        <img 
          src="/assets/lab/monsoon_vows_memory.jpg" 
          alt="Fine art chiaroscuro capture of couple in misty Kerala rain" 
          class="world-hero-image" 
          id="world-hero-image"
          loading="eager"
        />
        <div class="world-light-vignette"></div>
        <div class="world-rain-texture" aria-hidden="true"></div>
      </div>

      <!-- World Spatial Chrome -->
      <header class="world-threshold-header">
        <button type="button" class="btn-world-back" id="btn-world-back" aria-label="Return to Algoryxz Spatial Archive">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>← ALGORYXZ / 001 · CONCEPT PROJECT</span>
        </button>

        <div class="world-loc-tag">
          <span>KODAGU ESTATE // CHIDAMBARAM HALL</span>
        </div>
      </header>

      <!-- World Narrative Core -->
      <main class="world-content-stage">
        <div class="world-left-editorial">
          <span class="world-volume-label">HEIRLOOM FOLIO // VOL. 001</span>
          <h2 class="world-title">
            Moments carved in light.<br/>
            <em>Love preserved in time.</em>
          </h2>
          <p class="world-lead">
            An intimate digital sanctuary holding spoken vows, 42 private acoustic reels, petrichor soundscapes, and medium-format Hasselblad captures recorded during an October downpour.
          </p>

          <div class="world-curation-pills">
            <span class="curation-pill">Binaural Acoustic Reels</span>
            <span class="curation-pill">Hasselblad 500C/M</span>
            <span class="curation-pill">Parchment Archive</span>
          </div>
        </div>

        <div class="world-right-artifact">
          <!-- Translucent Parchment Heirloom Plaque -->
          <article class="heirloom-plaque">
            <div class="plaque-top-meta">
              <span class="plaque-wax-icon">📜</span>
              <span class="plaque-header-text">SPOKEN COVENANT // REEL NO. 04</span>
            </div>

            <blockquote class="plaque-vow-quote">
              “I promise to return to this sanctuary whenever the skies break, to listen for your footsteps in the courtyard, and never let the wet embers of our devotion turn cold.”
            </blockquote>

            <div class="plaque-signoff">
              <span class="vow-participants">Amara & Devendra</span>
              <span class="vow-timestamp">Dusk Downpour · Western Ghats</span>
            </div>

            <!-- Tactile Acoustic Player -->
            <div class="acoustic-playback-module" id="acoustic-playback-module">
              <button type="button" class="btn-audio-toggle" id="btn-audio-toggle" aria-label="Play acoustic vow recording">
                <svg class="icon-play-audio" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <svg class="icon-pause-audio" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none;">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                </svg>
              </button>

              <div class="audio-track-info">
                <span class="audio-track-title">THE RAIN OATH</span>
                <span class="audio-track-duration" id="audio-time-label">03:42 / 12:08</span>
              </div>

              <div class="audio-waveform-bars" id="audio-waveform-bars" aria-hidden="true">
                {Array.from({ length: 24 }).map((_, i) => (
                  <span 
                    class="wave-frequency-bar" 
                    style={`--bar-idx: ${i}; height: ${12 + ((i * 11 + 7) % 22)}px;`}
                  ></span>
                ))}
              </div>
            </div>

            <div class="plaque-wax-seal">
              <span class="seal-mark">🕯️</span>
              <span class="seal-caption">48 private family blessings sealed in archival ledger.</span>
            </div>
          </article>
        </div>
      </main>
    </div>

    <!-- DEV-ONLY DEBUG CONTROLLER (?debug=1 ONLY) -->
    <div class="r03-dev-hud" id="r03-dev-hud" style="display: none;">
      <div class="hud-header">
        <span class="hud-title">R03 SPATIAL // DEV HUD</span>
        <span class="hud-fps-badge" id="hud-fps">60 FPS</span>
      </div>

      <div class="hud-metrics">
        <div class="metric-line">
          <span class="metric-name">SCENE:</span>
          <span class="metric-val" id="hud-scene-name">ARRIVAL</span>
        </div>
        <div class="metric-line">
          <span class="metric-name">PROGRESS:</span>
          <span class="metric-val" id="hud-progress-val">0.000</span>
        </div>
        <div class="metric-line">
          <span class="metric-name">CAM POS:</span>
          <span class="metric-val" id="hud-cam-pos">0.0, 0.0, 14.0</span>
        </div>
        <div class="metric-line">
          <span class="metric-name">OBJ ROT:</span>
          <span class="metric-val" id="hud-obj-rot">0.0°, 0.0°</span>
        </div>
        <div class="metric-line">
          <span class="metric-name">MATERIAL %:</span>
          <span class="metric-val" id="hud-mat-pct">0%</span>
        </div>
      </div>

      <div class="hud-scrubber">
        <label for="hud-range-scrub">Scrub Timeline:</label>
        <input type="range" id="hud-range-scrub" min="0" max="1000" value="0" />
      </div>

      <div class="hud-stages">
        <button type="button" class="hud-btn" data-seek="0.0">A: Arrival</button>
        <button type="button" class="hud-btn" data-seek="0.32">B: Unfurl</button>
        <button type="button" class="hud-btn" data-seek="0.65">C: Archive</button>
        <button type="button" class="hud-btn" data-seek="0.88">D: Portal</button>
        <button type="button" class="hud-btn" data-seek="1.0">E: World</button>
      </div>

      <div class="hud-toggles">
        <button type="button" class="hud-btn-sub" id="hud-toggle-wire">Wireframe</button>
        <button type="button" class="hud-btn-sub" id="hud-reset-cam">Reset Cam</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* -------------------------------------------------------------
   * REVISION 03 SPATIAL PALETTE & TYPOGRAPHY SYSTEM
   * ----------------------------------------------------------- */
  :root {
    --r03-bg-sable: #08090b;
    --r03-bg-graphite: #0e1014;
    --r03-bg-charcoal: #15181f;
    --r03-text-ecru: #f5f2eb;
    --r03-text-dim: rgba(245, 242, 235, 0.65);
    --r03-text-muted: rgba(245, 242, 235, 0.42);
    --r03-amber-mineral: #d97736;
    --r03-amber-glow: rgba(217, 119, 54, 0.35);
    --r03-amber-hot: #f09b52;
    --r03-border-subtle: rgba(245, 242, 235, 0.12);
    --r03-border-accent: rgba(217, 119, 54, 0.38);

    --font-serif-cinematic: 'Playfair Display', Georgia, serif;
    --font-sans-studio: 'Hanken Grotesk', system-ui, -apple-system, sans-serif;
    --font-mono-spatial: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  }

  /* Hide Default Layout Navigation & Footer to preserve unboxed quiet studio chrome */
  :global(.site-header),
  :global(.site-footer) {
    display: none !important;
  }

  /* Full Page Spatial Canvas Container */
  .r03-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: var(--r03-bg-sable);
    color: var(--r03-text-ecru);
    font-family: var(--font-sans-studio);
    overflow-x: hidden;
  }

  /* Fixed Recessive Studio Header (Unboxed, Minimal Chrome) */
  .r03-studio-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: 1.5rem 2.5rem;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
  }

  .studio-brand {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--r03-text-ecru);
    pointer-events: auto;
  }

  .brand-text {
    font-family: var(--font-mono-spatial);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--r03-text-ecru);
  }

  .brand-sub {
    font-family: var(--font-mono-spatial);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--r03-amber-mineral);
  }

  .header-coords {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono-spatial);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--r03-text-muted);
  }

  .coord-sep {
    color: rgba(245, 242, 235, 0.2);
  }

  .coord-active {
    color: var(--r03-amber-hot);
    font-weight: 600;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    pointer-events: auto;
  }

  .nav-link {
    font-family: var(--font-mono-spatial);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--r03-text-dim);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--r03-text-ecru);
  }

  .nav-link-cta {
    color: var(--r03-amber-hot);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--r03-border-accent);
    border-radius: 4px;
    background: rgba(217, 119, 54, 0.08);
  }

  .nav-link-cta:hover {
    background: rgba(217, 119, 54, 0.2);
  }

  /* Fullscreen Fixed Three.js Canvas Container */
  .r03-webgl-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 10;
    pointer-events: auto;
    background: radial-gradient(circle at 50% 48%, #11141b 0%, #08090b 75%);
  }

  /* Continuous Spatial Scroll Track */
  .spatial-scroll-track {
    position: relative;
    z-index: 20;
    min-height: 420vh;
    pointer-events: none;
  }

  .spatial-stage {
    position: relative;
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 4rem;
    box-sizing: border-box;
  }

  .stage-shell {
    width: 100%;
    max-width: 1440px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* STAGE A: ARRIVAL */
  .arrival-shell {
    justify-content: center;
    position: relative;
  }

  .hero-typographic-core {
    max-width: 780px;
    z-index: 25;
    pointer-events: auto;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
  }

  .kicker-quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono-spatial);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--r03-amber-mineral);
    margin-bottom: 1.5rem;
  }

  .kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--r03-amber-hot);
    box-shadow: 0 0 10px var(--r03-amber-hot);
  }

  .hero-headline {
    font-family: var(--font-sans-studio);
    font-size: clamp(3rem, 6.2vw, 6.4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 0 0 2rem 0;
    color: var(--r03-text-ecru);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.8);
  }

  .hero-headline .line {
    display: block;
  }

  .hero-headline .line-3 {
    color: var(--r03-text-dim);
  }

  .hero-manifesto {
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    line-height: 1.55;
    color: var(--r03-text-dim);
    max-width: 540px;
    margin: 0;
    font-weight: 400;
  }

  .arrival-footer-affordance {
    position: absolute;
    bottom: 3rem;
    left: 4rem;
    right: 4rem;
    display: flex;
    justify-content: flex-start;
    pointer-events: auto;
  }

  .scroll-instruction {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono-spatial);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--r03-text-muted);
  }

  .scroll-chevron-track {
    display: flex;
    align-items: center;
    color: var(--r03-amber-mineral);
    animation: bounceDown 2s infinite ease-in-out;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* STAGE B: UNFURL */
  .unfurl-shell {
    justify-content: flex-end;
    padding-bottom: 6rem;
  }

  .unfurl-annotation {
    max-width: 420px;
    background: rgba(14, 16, 20, 0.75);
    border-left: 2px solid var(--r03-amber-mineral);
    backdrop-filter: blur(12px);
    padding: 1.25rem 1.75rem;
    border-radius: 0 8px 8px 0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .annotation-tag {
    font-family: var(--font-mono-spatial);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--r03-amber-hot);
    display: block;
    margin-bottom: 0.5rem;
  }

  .annotation-text {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--r03-text-dim);
    margin: 0;
  }

  /* STAGE C: ARCHIVE EMERGENCE */
  .archive-shell {
    justify-content: center;
    gap: 3rem;
  }

  .archive-editorial-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }

  .archive-kicker {
    font-family: var(--font-mono-spatial);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--r03-amber-mineral);
    display: block;
    margin-bottom: 0.75rem;
  }

  .archive-title {
    font-family: var(--font-serif-cinematic);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.5rem 0;
    color: var(--r03-text-ecru);
  }

  .archive-guide {
    font-family: var(--font-mono-spatial);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--r03-text-muted);
    margin: 0;
  }

  .archive-fragments-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    width: 100%;
  }

  /* Fragment Spatial Anchors (Subtle, Non-Card Descendants) */
  .fragment-spatial-anchor {
    position: relative;
    background: rgba(14, 16, 20, 0.65);
    border: 1px solid var(--r03-border-subtle);
    backdrop-filter: blur(16px);
    border-radius: 12px;
    padding: 2.25rem 2rem;
    text-align: left;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease;
  }

  .fragment-spatial-anchor:hover, 
  .fragment-spatial-anchor:focus-visible {
    transform: translateY(-6px);
    border-color: rgba(245, 242, 235, 0.3);
    background: rgba(21, 24, 31, 0.85);
    outline: none;
  }

