</style>

<script>
  import * as THREE from 'three';

  // ---------------------------------------------------------------------------
  // CLIENT RUNTIME SPATIAL CONTROLLER
  // ---------------------------------------------------------------------------
  function initRevision03Experience() {
    const canvasContainer = document.getElementById('r03-webgl-canvas');
    if (!canvasContainer) return;

    // Detect Debug Mode (?debug=1)
    const urlParams = new URLSearchParams(window.location.search);
    const isDebugMode = urlParams.get('debug') === '1';
    const devHud = document.getElementById('r03-dev-hud');
    if (isDebugMode && devHud) {
      devHud.style.display = 'block';
    }

    // Detect Accessibility Preferences
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Viewport Dimension Tracking
    let viewWidth = window.innerWidth;
    let viewHeight = window.innerHeight;
    let isMobile = viewWidth <= 768;

    // 1. Scene, Camera, Renderer Setup
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x08090b, isMobile ? 0.045 : 0.038);

    const camera = new THREE.PerspectiveCamera(45, viewWidth / viewHeight, 0.1, 100);
    const defaultCamZ = isMobile ? 19 : 14;
    camera.position.set(0, 0, defaultCamZ);

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(viewWidth, viewHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;
    canvasContainer.appendChild(renderer.domElement);

    // 2. Curated Lighting System
    const ambientLight = new THREE.AmbientLight(0x0a0c10, 1.8);
    scene.add(ambientLight);

    const hemiLight = new THREE.HemisphereLight(0x3a4556, 0x08090b, 1.4);
    scene.add(hemiLight);

    // Key Light: Warm mineral sunlight grazing the facets
    const keyWarmLight = new THREE.DirectionalLight(0xf09b52, 4.2);
    keyWarmLight.position.set(8, 11, 9);
    keyWarmLight.castShadow = true;
    keyWarmLight.shadow.mapSize.width = isMobile ? 512 : 1024;
    keyWarmLight.shadow.mapSize.height = isMobile ? 512 : 1024;
    scene.add(keyWarmLight);

    // Rim Light: Graphite edge separation
    const rimCoolLight = new THREE.DirectionalLight(0x60728a, 2.2);
    rimCoolLight.position.set(-9, -4, -6);
    scene.add(rimCoolLight);

    // Internal Seam PointLight (illuminates fissures when sculpture unlocks)
    const seamCoreLight = new THREE.PointLight(0xf09b52, 5.0, 20);
    seamCoreLight.position.set(0, 0, 0);
    scene.add(seamCoreLight);

    // 3. Precision Materials Definition
    const graphiteMat = new THREE.MeshStandardMaterial({
      color: 0x1e2129,
      roughness: 0.28,
      metalness: 0.42,
      side: THREE.DoubleSide
    });

    const bronzeEdgeMat = new THREE.MeshStandardMaterial({
      color: 0xe08238,
      roughness: 0.22,
      metalness: 0.88,
      emissive: 0x3d1a04,
      emissiveIntensity: 0.4,
      side: THREE.DoubleSide
    });

    // Living Memory Texture for Keystone Fragment (/001)
    const textureLoader = new THREE.TextureLoader();
    const memoryTexture = textureLoader.load('/assets/lab/monsoon_vows_memory.jpg');
    memoryTexture.colorSpace = THREE.SRGBColorSpace;

    // Metamorphic Material for Fragment 001
    const keystoneMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x222630,
      roughness: 0.26,
      metalness: 0.32,
      emissive: 0x301808,
      emissiveIntensity: 0.35,
      transparent: true,
      opacity: 0.98,
      side: THREE.DoubleSide
    });

    // 4. Procedural XZ-Derived Architecture Hierarchy
    const masterSculptureGroup = new THREE.Group();
    scene.add(masterSculptureGroup);

    // Assembly Groups
    const frag000Group = new THREE.Group(); // Studio Engine (Left/Back Wing)
    const frag001Group = new THREE.Group(); // Keystone Living Memory (Center/Forward)
    const frag002Group = new THREE.Group(); // Brand Flagship (Right/Back Wing)
    const flybyShearPlane = new THREE.Group(); // Kinetic Shear Plate (Robot Flyby physical event)

    masterSculptureGroup.add(frag000Group);
    masterSculptureGroup.add(frag001Group);
    masterSculptureGroup.add(frag002Group);
    masterSculptureGroup.add(flybyShearPlane);

    // Geometry Builder Helper: Extruded Folded Facets with Chamfered Edges
    function createFoldedFacet(points: [number, number][], depth: number, mat: THREE.Material) {
      const shape = new THREE.Shape();
      if (points.length > 0) {
        shape.moveTo(points[0][0], points[0][1]);
        for (let i = 1; i < points.length; i++) {
          shape.lineTo(points[i][0], points[i][1]);
        }
        shape.closePath();
      }

      const extrudeSettings = {
        depth: depth,
        bevelEnabled: true,
        bevelSegments: 2,
        steps: 1,
        bevelSize: 0.04,
        bevelThickness: 0.04
      };
      const geom = new THREE.ExtrudeGeometry(shape, extrudeSettings);
      geom.center();
      const mesh = new THREE.Mesh(geom, mat);
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      return mesh;
    }

    // Build Fragment 001: Central Keystone Chevron (The Heart of X and Z)
    // 1. Structural graphite base chevron
    const f001BaseMesh = createFoldedFacet([
      [-1.8, -1.2],
      [-0.4, -1.4],
      [1.6, 1.3],
      [0.6, 1.5],
      [-1.2, 0.2]
    ], 0.45, keystoneMaterial);
    frag001Group.add(f001BaseMesh);

    // 2. Interlocking cross diagonal plate
    const f001CrossMesh = createFoldedFacet([
      [-1.4, 1.3],
      [-0.2, 1.4],
      [1.7, -1.1],
      [0.8, -1.4],
      [-0.6, -0.2]
    ], 0.38, graphiteMat);
    f001CrossMesh.position.set(0, 0, 0.15);
    frag001Group.add(f001CrossMesh);

    // 3. Warm bronze seam core
    const f001BronzeSeam = createFoldedFacet([
      [-0.3, -0.8],
      [0.3, -0.8],
      [0.3, 0.8],
      [-0.3, 0.8]
    ], 0.55, bronzeEdgeMat);
    frag001Group.add(f001BronzeSeam);

    // Build Fragment 000: Upper-Left & Lower-Left Opposing Diagonal Wing (Algoryxz Engine)
    const f000WingUpper = createFoldedFacet([
      [-3.2, 0.5],
      [-1.6, 0.8],
      [-0.9, 2.2],
      [-2.4, 2.4]
    ], 0.4, graphiteMat);
    frag000Group.add(f000WingUpper);

    const f000WingLower = createFoldedFacet([
      [-3.0, -2.1],
      [-1.5, -0.6],
      [-1.0, -1.6],
      [-2.2, -2.6]
    ], 0.35, graphiteMat);
    frag000Group.add(f000WingLower);

    const f000BronzeRib = createFoldedFacet([
      [-2.8, -0.2],
      [-1.4, -0.1],
      [-1.6, 0.3],
      [-3.0, 0.2]
    ], 0.48, bronzeEdgeMat);
    frag000Group.add(f000BronzeRib);

    // Build Fragment 002: Upper-Right & Lower-Right Stepped Z Flange (Craft Flagship)
    const f002WingUpper = createFoldedFacet([
      [1.1, 1.8],
      [2.6, 2.4],
      [3.1, 0.8],
      [1.8, 0.5]
    ], 0.4, graphiteMat);
    frag002Group.add(f002WingUpper);

    const f002WingLower = createFoldedFacet([
      [1.2, -0.7],
      [2.9, -1.9],
      [2.3, -2.5],
      [0.8, -1.5]
    ], 0.35, graphiteMat);
    frag002Group.add(f002WingLower);

    const f002BronzeRib = createFoldedFacet([
      [1.5, -0.1],
      [2.9, -0.2],
      [3.1, 0.2],
      [1.7, 0.3]
    ], 0.48, bronzeEdgeMat);
    frag002Group.add(f002BronzeRib);

    // Build Kinetic Flyby Shear Plate (The Robot Flyby Physical Event)
    const flybyMesh = createFoldedFacet([
      [-4.0, 1.6],
      [-0.5, 3.2],
      [2.2, 2.5],
      [-1.0, 0.4]
    ], 0.25, graphiteMat);
    const flybyTrim = createFoldedFacet([
      [-3.8, 1.5],
      [-0.6, 3.0],
      [2.0, 2.4],
      [-0.8, 0.6]
    ], 0.28, bronzeEdgeMat);
    flybyShearPlane.add(flybyMesh);
    flybyShearPlane.add(flybyTrim);
    flybyShearPlane.position.set(0, 0, 0.6);

    // 5. Scroll State Tracking & Smoothing Pipeline
    let targetScrollProgress = 0;
    let smoothScrollProgress = 0;
    const maxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);

    function onScrollUpdate() {
      const scrollY = window.scrollY || window.pageYOffset;
      targetScrollProgress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
    }
    window.addEventListener('scroll', onScrollUpdate, { passive: true });
    onScrollUpdate();

    // Pointer Interaction Physics (Lerped Mouse Parallax & Tilt)
    const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
    window.addEventListener('mousemove', (e) => {
      mouse.targetX = (e.clientX / viewWidth) * 2 - 1;
      mouse.targetY = -(e.clientY / viewHeight) * 2 + 1;
    }, { passive: true });

    // Touch Support for Mobile
    window.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        mouse.targetX = (e.touches[0].clientX / viewWidth) * 2 - 1;
        mouse.targetY = -(e.touches[0].clientY / viewHeight) * 2 + 1;
      }
    }, { passive: true });

    // 6. DOM Element Caches
    const stageIndicator = document.getElementById('header-stage-indicator');
    const heroTypoCore = document.getElementById('hero-typo-core');
    const arrivalAffordance = document.getElementById('arrival-affordance');
    const unfurlAnnotation = document.getElementById('unfurl-annotation');
    const clientWorldViewport = document.getElementById('client-world-viewport');
    const btnWorldBack = document.getElementById('btn-world-back');

    // Debug HUD Element Caches
    const hudSceneName = document.getElementById('hud-scene-name');
    const hudProgressVal = document.getElementById('hud-progress-val');
    const hudCamPos = document.getElementById('hud-cam-pos');
    const hudObjRot = document.getElementById('hud-obj-rot');
    const hudMatPct = document.getElementById('hud-mat-pct');
    const hudFps = document.getElementById('hud-fps');
    const hudRangeScrub = document.getElementById('hud-range-scrub') as HTMLInputElement | null;

    // Portal Engagement State
    let isPortalActive = false;
    let portalTransitionLerp = 0; // 0 (Archive) -> 1 (Client World)

    let portalEngagedByClick = false;

    function engagePortal001(byClick: boolean = false) {
      isPortalActive = true;
      portalEngagedByClick = byClick;
      if (clientWorldViewport) {
        clientWorldViewport.classList.add('active');
        clientWorldViewport.setAttribute('aria-hidden', 'false');
      }
      const maxScrollVal = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      window.scrollTo({ top: maxScrollVal, behavior: 'smooth' });
    }

    function exitPortal001() {
      isPortalActive = false;
      portalEngagedByClick = false;
      if (clientWorldViewport) {
        clientWorldViewport.classList.remove('active');
        clientWorldViewport.setAttribute('aria-hidden', 'true');
      }
      const maxScrollVal = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      if (window.scrollY > maxScrollVal * 0.8) {
        window.scrollTo({ top: maxScrollVal * 0.65, behavior: 'smooth' });
      }
    }

    // Fragment Button Event Listeners
    const btnFrag001 = document.getElementById('anchor-frag-001');
    if (btnFrag001) {
      btnFrag001.addEventListener('click', () => engagePortal001(true));
      btnFrag001.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          engagePortal001(true);
        }
      });
    }

    const btnFrag000 = document.getElementById('anchor-frag-000');
    if (btnFrag000) {
      btnFrag000.addEventListener('click', () => {
        // Subtle haptic tilt
        frag000Group.position.z += 0.3;
        setTimeout(() => { frag000Group.position.z -= 0.3; }, 300);
      });
    }

    const btnFrag002 = document.getElementById('anchor-frag-002');
    if (btnFrag002) {
      btnFrag002.addEventListener('click', () => {
        frag002Group.position.z += 0.3;
        setTimeout(() => { frag002Group.position.z -= 0.3; }, 300);
      });
    }

    if (btnWorldBack) {
      btnWorldBack.addEventListener('click', () => exitPortal001());
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isPortalActive) {
        exitPortal001();
      }
    });

    // Audio Player Toggle
    const btnAudio = document.getElementById('btn-audio-toggle');
    const audioModule = document.getElementById('acoustic-playback-module');
    let isAudioPlaying = false;
    if (btnAudio && audioModule) {
      btnAudio.addEventListener('click', () => {
        isAudioPlaying = !isAudioPlaying;
        audioModule.classList.toggle('playing', isAudioPlaying);
        const iconPlay = btnAudio.querySelector('.icon-play-audio') as HTMLElement;
        const iconPause = btnAudio.querySelector('.icon-pause-audio') as HTMLElement;
        if (iconPlay && iconPause) {
          iconPlay.style.display = isAudioPlaying ? 'none' : 'block';
          iconPause.style.display = isAudioPlaying ? 'block' : 'none';
        }
      });
    }

    // Debug Scrubber Listener
    if (hudRangeScrub) {
      hudRangeScrub.addEventListener('input', (e) => {
        const val = parseFloat((e.target as HTMLInputElement).value) / 1000;
        window.scrollTo(0, val * maxScroll);
      });
    }

    // Debug Jump Buttons
    const hudButtons = document.querySelectorAll('.hud-btn');
    hudButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const seek = parseFloat(btn.getAttribute('data-seek') || '0');
        window.scrollTo({
          top: seek * maxScroll,
          behavior: 'smooth'
        });
      });
    });

    // Debug Wireframe Toggle
    const hudToggleWire = document.getElementById('hud-toggle-wire');
    let isWireframe = false;
    if (hudToggleWire) {
      hudToggleWire.addEventListener('click', () => {
        isWireframe = !isWireframe;
        graphiteMat.wireframe = isWireframe;
        keystoneMaterial.wireframe = isWireframe;
        bronzeEdgeMat.wireframe = isWireframe;
      });
    }

    // Debug Reset Cam
    const hudResetCam = document.getElementById('hud-reset-cam');
    if (hudResetCam) {
      hudResetCam.addEventListener('click', () => {
        camera.position.set(0, 0, defaultCamZ);
      });
    }

    // 7. Core Render Loop Physics & Animation Timeline
    let frameCount = 0;
    let lastFpsUpdate = performance.now();

    function animate(currentTime: number) {
      requestAnimationFrame(animate);

      // FPS Telemetry
      frameCount++;
      if (currentTime - lastFpsUpdate >= 500) {
        const currentFps = Math.round((frameCount * 1000) / (currentTime - lastFpsUpdate));
        if (hudFps) hudFps.textContent = `${currentFps} FPS`;
        frameCount = 0;
        lastFpsUpdate = currentTime;
      }

      // Smooth Lerps
      smoothScrollProgress += (targetScrollProgress - smoothScrollProgress) * (prefersReducedMotion ? 0.3 : 0.08);
      mouse.x += (mouse.targetX - mouse.x) * 0.05;
      mouse.y += (mouse.targetY - mouse.y) * 0.05;

      const p = smoothScrollProgress;
      const targetPortal = isPortalActive ? 1 : 0;
      portalTransitionLerp += (targetPortal - portalTransitionLerp) * 0.08;

      // Determine Narrative Phase
      let scenePhase = 'ARRIVAL';
      if (p < 0.22) {
        scenePhase = 'ARRIVAL';
      } else if (p < 0.52) {
        scenePhase = 'UNFURL';
      } else if (p < 0.82) {
        scenePhase = 'ARCHIVE';
      } else {
        scenePhase = 'PORTAL';
      }
      if (portalTransitionLerp > 0.65) {
        scenePhase = 'CLIENT_WORLD';
      }

      // Update Header Coordinates
      if (stageIndicator) {
        stageIndicator.textContent = `STAGE // ${scenePhase}`;
      }

      // -------------------------------------------------------------
      // 3D SPATIAL KINEMATICS & SCENE TIMELINE
      // -------------------------------------------------------------

      // 1. Master Group Base Float / Idle Rotation
      const idleFloat = Math.sin(currentTime * 0.001) * 0.03;
      const tiltX = (mouse.y * 0.15);
      const tiltY = (mouse.x * 0.2);

      // Phase Progressions:
      // A. Arrival (0.00 -> 0.20): Sculpture is a closed, dense interlocking monolith
      // B. Unfurl (0.20 -> 0.50): Opposing diagonals unlock & slide along axes
      // C. Archive (0.50 -> 0.80): Settle into 000, 001, 002 archive configuration
      // D. Portal (0.80 -> 1.00): /001 approaches camera, expands, consumes frame

      const unfurlWeight = Math.min(Math.max((p - 0.20) / 0.32, 0), 1);
      const archiveWeight = Math.min(Math.max((p - 0.50) / 0.30, 0), 1);
      const scrollPortalWeight = Math.min(Math.max((p - 0.80) / 0.20, 0), 1);
      const effectivePortal = Math.max(scrollPortalWeight, portalTransitionLerp);

      // Object Group Transform (Dominant ~45% composition on right in Arrival, centering in Archive)
      const initialHeroX = isMobile ? 0 : 2.6;
      masterSculptureGroup.position.x = initialHeroX * (1 - archiveWeight);
      masterSculptureGroup.position.y = (isMobile ? -0.4 : -0.1) + (unfurlWeight * 0.1) - (effectivePortal * 0.3);
      masterSculptureGroup.rotation.x = 0.32 - (unfurlWeight * 0.32) + tiltX + idleFloat;
      masterSculptureGroup.rotation.y = -0.48 + (unfurlWeight * 0.48) + tiltY;
      masterSculptureGroup.rotation.z = 0.12 - (unfurlWeight * 0.12);
      masterSculptureGroup.scale.setScalar(isMobile ? 1.05 : 1.38);

      // Light seam intensifies as internal core opens
      seamCoreLight.intensity = 2.5 + (unfurlWeight * 4.5);

      // --- KINETIC FLYBY SHEAR PLANE (Robot Flyby Event) ---
      // Sweeps past camera during unfurl (p between 0.25 and 0.50)
      if (p < 0.18) {
        flybyShearPlane.position.set(0, 0, 0.4);
        flybyShearPlane.rotation.set(0, 0, 0);
        flybyShearPlane.scale.set(1, 1, 1);
      } else if (p < 0.55) {
        const flybyT = (p - 0.18) / 0.37;
        // Sweeps forward along Z from 0.4 to 8.5 (close to camera) while panning right
        flybyShearPlane.position.z = 0.4 + Math.sin(flybyT * Math.PI) * 7.5;
        flybyShearPlane.position.x = flybyT * 5.5;
        flybyShearPlane.position.y = -flybyT * 1.5;
        flybyShearPlane.rotation.y = flybyT * 1.8;
        flybyShearPlane.rotation.z = flybyT * -0.6;
      } else {
        // Parked in spatial periphery
        flybyShearPlane.position.set(12, 4, -4);
      }

      // --- FRAGMENT 000: Studio Engine (Left / Back Wing) ---
      const f000TargetX = -4.6 * archiveWeight;
      const f000TargetY = 0.3 * archiveWeight;
      const f000TargetZ = -2.6 * archiveWeight;
      frag000Group.position.x = (unfurlWeight * -1.8) + (archiveWeight * (f000TargetX - (unfurlWeight * -1.8))) - (effectivePortal * 6.0);
      frag000Group.position.y = (unfurlWeight * 0.4) + (archiveWeight * (f000TargetY - (unfurlWeight * 0.4)));
      frag000Group.position.z = (unfurlWeight * -0.8) + (archiveWeight * (f000TargetZ - (unfurlWeight * -0.8))) - (effectivePortal * 4.0);
      frag000Group.rotation.y = unfurlWeight * 0.35;

      // --- FRAGMENT 002: Craft Flagship (Right / Back Wing) ---
      const f002TargetX = 4.6 * archiveWeight;
      const f002TargetY = -0.2 * archiveWeight;
      const f002TargetZ = -2.4 * archiveWeight;
      frag002Group.position.x = (unfurlWeight * 1.8) + (archiveWeight * (f002TargetX - (unfurlWeight * 1.8))) + (effectivePortal * 6.0);
      frag002Group.position.y = (unfurlWeight * -0.3) + (archiveWeight * (f002TargetY - (unfurlWeight * -0.3)));
      frag002Group.position.z = (unfurlWeight * -0.7) + (archiveWeight * (f002TargetZ - (unfurlWeight * -0.7))) - (effectivePortal * 4.0);
      frag002Group.rotation.y = unfurlWeight * -0.35;

      // --- FRAGMENT 001: Central Keystone (Living Memory / Monsoon Vows) ---
      // In Archive state: Centered forward, dominant
      // In Portal state: Approaches camera, flattens angle, expands, consumes viewport
      const f001ArchX = 0;
      const f001ArchY = -0.15;
      const f001ArchZ = 1.3 * archiveWeight;

      frag001Group.position.x = (archiveWeight * f001ArchX);
      frag001Group.position.y = (archiveWeight * f001ArchY) * (1 - effectivePortal);
      frag001Group.position.z = f001ArchZ + (effectivePortal * (defaultCamZ - 3.2));

      // As portal engages, orient perpendicular to camera
      frag001Group.rotation.x = (1 - effectivePortal) * (unfurlWeight * 0.1);
      frag001Group.rotation.y = (1 - effectivePortal) * (unfurlWeight * 0.05);

      // Material Metamorphosis of Fragment 001
      // Graphite -> Warm Translucent Resin / Amber Backlight -> Living Memory Photography
      if (effectivePortal > 0.05) {
        keystoneMaterial.roughness = THREE.MathUtils.lerp(0.35, 0.12, effectivePortal);
        keystoneMaterial.metalness = THREE.MathUtils.lerp(0.3, 0.05, effectivePortal);
        keystoneMaterial.emissiveIntensity = THREE.MathUtils.lerp(0.2, 2.5, effectivePortal);
        if (effectivePortal > 0.35 && !keystoneMaterial.map) {
          keystoneMaterial.map = memoryTexture;
          keystoneMaterial.needsUpdate = true;
        }
      } else {
        if (keystoneMaterial.map) {
          keystoneMaterial.map = null;
          keystoneMaterial.roughness = 0.35;
          keystoneMaterial.metalness = 0.3;
          keystoneMaterial.emissiveIntensity = 0.2;
          keystoneMaterial.needsUpdate = true;
        }
      }

      // Camera Travel
      camera.position.z = defaultCamZ - (effectivePortal * 3.5);

      // -------------------------------------------------------------
      // DOM TYPOGRAPHY & OVERLAY SYNCHRONIZATION
      // -------------------------------------------------------------
      if (heroTypoCore) {
        // Hero typography recedes backwards with perspective in scroll
        const heroRecede = Math.min(p / 0.25, 1);
        heroTypoCore.style.transform = `translate3d(0, ${heroRecede * -50}px, 0) scale(${1 - heroRecede * 0.12})`;
        heroTypoCore.style.opacity = `${Math.max(1 - heroRecede * 1.5, 0)}`;
        heroTypoCore.style.pointerEvents = heroRecede > 0.8 ? 'none' : 'auto';
      }

      if (arrivalAffordance) {
        arrivalAffordance.style.opacity = `${Math.max(1 - (p / 0.15), 0)}`;
      }

      if (unfurlAnnotation) {
        const annotOpacity = (p >= 0.20 && p <= 0.52) ? 1 : 0;
        unfurlAnnotation.style.opacity = `${annotOpacity}`;
      }

      // Studio Header Recede during Portal & Client World
      const studioHeaderEl = document.getElementById('studio-header');
      if (studioHeaderEl) {
        if (effectivePortal > 0.5) {
          studioHeaderEl.style.opacity = `${Math.max(1 - ((effectivePortal - 0.5) / 0.3), 0)}`;
          studioHeaderEl.style.pointerEvents = effectivePortal > 0.8 ? 'none' : 'auto';
        } else {
          studioHeaderEl.style.opacity = '1';
          studioHeaderEl.style.pointerEvents = 'auto';
        }
      }

      // Trigger Client World Full Viewport when portal threshold is reached via scroll
      if (p > 0.94 && !isPortalActive) {
        engagePortal001(false);
      } else if (p < 0.85 && isPortalActive && !portalEngagedByClick) {
        exitPortal001();
      }

      // -------------------------------------------------------------
      // DEBUG HUD TELEMETRY UPDATE
      // -------------------------------------------------------------
      if (isDebugMode) {
        if (hudSceneName) hudSceneName.textContent = scenePhase;
        if (hudProgressVal) hudProgressVal.textContent = p.toFixed(3);
        if (hudCamPos) hudCamPos.textContent = `${camera.position.x.toFixed(1)}, ${camera.position.y.toFixed(1)}, ${camera.position.z.toFixed(1)}`;
        if (hudObjRot) hudObjRot.textContent = `${(masterSculptureGroup.rotation.x * 57.3).toFixed(0)}°, ${(masterSculptureGroup.rotation.y * 57.3).toFixed(0)}°`;
        if (hudMatPct) hudMatPct.textContent = `${Math.round(effectivePortal * 100)}%`;
      }

      renderer.render(scene, camera);
    }

    requestAnimationFrame(animate);

    // 8. Responsive Resize Handler
    window.addEventListener('resize', () => {
      viewWidth = window.innerWidth;
      viewHeight = window.innerHeight;
      isMobile = viewWidth <= 768;

      camera.aspect = viewWidth / viewHeight;
      camera.position.z = isMobile ? 19 : 14;
      camera.updateProjectionMatrix();

      renderer.setSize(viewWidth, viewHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    }, { passive: true });
  }

  // Initialize once DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRevision03Experience);
  } else {
    initRevision03Experience();
  }
</script>
