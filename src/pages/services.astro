---
import BaseLayout from '../layouts/BaseLayout.astro';
import MaterialArtifact from '../components/MaterialArtifact.astro';
import '../styles/experience.css';
const worlds = [
 {id:'someone',name:'FOR SOMEONE',number:'01',kind:'someone' as const,heading:'A little piece of forever.',copy:'For a person. For a day. For the things you wish you could keep.',details:'Invitations · Celebrations · Photo stories · Personal places'},
 {id:'business',name:'FOR A BUSINESS',number:'02',kind:'business' as const,heading:'Make your presence felt.',copy:'A digital place with the same character as the business you are building.',details:'Websites · Digital storefronts · Menus · Brand experiences'},
 {id:'stranger',name:'SOMETHING STRANGER',number:'03',kind:'structure' as const,heading:'Give the idea a shape.',copy:'An unusual interface. A tool that should exist. Something we have not made yet.',details:'Interactive experiences · Custom systems · Bespoke tools'}
];
---
<BaseLayout title="What do you want to make?" description="Personal experiences, business websites, and stranger ideas. Explore the material worlds of Algoryxz.">
 <section class="experience material-room" data-world="initial" aria-labelledby="services-heading">
  <div class="material-seam" aria-hidden="true"></div>
  <div class="service-opening"><p class="eyebrow">SERVICES / POSSIBILITIES</p><h1 id="services-heading">WHAT DO YOU<br/>WANT TO MAKE?</h1></div>
  <div class="service-choices" role="group" aria-label="Choose a material world">{worlds.map(w=><button type="button" data-world-choice={w.id} aria-pressed="false" aria-controls={`material-${w.id}`}><span>{w.number}</span>{w.name}<b aria-hidden="true">↗</b></button>)}</div>
  <div class="initial-material" aria-hidden="true"><MaterialArtifact kind="structure"/></div>
  <p class="initial-note">One underlying structure.<br/>Whatever you bring to it.</p>
  {worlds.map(w=><div class="service-world" id={`material-${w.id}`} hidden>
   <div class="service-art"><MaterialArtifact kind={w.kind}/></div>
   <div class="service-description" aria-live="polite"><p class="eyebrow">{w.details}</p><h2>{w.heading}</h2><p>{w.copy}</p><a class="text-link" href={`/contact?type=${w.id}`}>LET’S MAKE IT <span>↗</span></a></div>
  </div>)}
  <div class="room-caption eyebrow"><span>ALGORYXZ = STRUCTURE</span><span>YOU = MATERIAL</span></div>
 </section>
 <noscript><section class="service-nojs">{worlds.map(w=><article><h2>{w.name}</h2><p>{w.copy} {w.details}</p><a href="/contact">Let’s make it ↗</a></article>)}</section></noscript>
</BaseLayout>
<script>
 const room=document.querySelector<HTMLElement>('.material-room')!;
 const choices=[...document.querySelectorAll<HTMLButtonElement>('[data-world-choice]')];
 function selectWorld(id:string,updateUrl=true){
  if(!choices.some(b=>b.dataset.worldChoice===id))return;
  room.dataset.world=id;
  choices.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.worldChoice===id)));
  room.querySelectorAll<HTMLElement>('.service-world').forEach(w=>w.hidden=w.id!==`material-${id}`);
  if(updateUrl)history.replaceState(null,'',`#${id}`);
 }
 choices.forEach(button=>button.addEventListener('click',()=>selectWorld(button.dataset.worldChoice!)));
 const aliases:Record<string,string>={celebrations:'someone',custom:'stranger',care:'business'};
 function fromHash(){const id=location.hash.slice(1);selectWorld(aliases[id]||id,false);}
 window.addEventListener('hashchange',fromHash);fromHash();
</script>
<style>
.material-room{min-height:calc(100svh - 85px);height:815px;position:relative;overflow:clip;padding:43px 3.4vw 35px;isolation:isolate;transition:background 700ms,color 700ms;background:radial-gradient(ellipse at 78% 57%,#47352744,transparent 50%),#10100f}.material-seam{position:absolute;inset:-15% 12% -30% 52%;border-left:1px solid #e4c19a38;border-right:1px solid #e4c19a18;transform:skewX(-32deg);z-index:-1;transition:transform .8s}.material-seam::after{content:'';position:absolute;inset:10% 35%;background:linear-gradient(90deg,transparent,#d3ac7720,transparent)}.service-opening{position:relative;z-index:3;pointer-events:none}.service-opening .eyebrow{margin-bottom:24px}h1{font-size:clamp(55px,7.5vw,120px);line-height:.94;letter-spacing:-.065em;font-weight:500}.service-choices{position:relative;z-index:5;display:flex;flex-direction:column;align-items:stretch;width:45%;margin-top:55px}.service-choices button{display:flex;align-items:center;text-align:left;min-height:77px;border-bottom:1px solid #eee9df35;font-size:clamp(18px,2vw,29px);letter-spacing:-.03em;gap:20px;transition:color .25s}.service-choices button>span{font:9px monospace;letter-spacing:0;color:#c7bba9}.service-choices button b{font-size:20px;margin-left:auto;font-weight:400}.service-choices button[aria-pressed=true]{color:#efb384}.service-choices button:hover{color:#efb384}.initial-material{position:absolute;width:51%;height:78%;right:0;top:18%;transition:opacity .35s}.initial-note{position:absolute;left:3.4%;bottom:12%;font-size:14px;color:#aca396}.material-room:not([data-world=initial]) .initial-material,.material-room:not([data-world=initial]) .initial-note{opacity:0;pointer-events:none}.service-world[hidden]{display:none}.service-art{position:absolute;width:34%;height:52%;right:8%;top:25%;z-index:2}.service-description{position:absolute;left:3.4%;bottom:11%;width:43%;z-index:4}.service-description .eyebrow{font-size:8px;letter-spacing:.05em;color:inherit}.service-description h2{font-family:Georgia,serif;font-size:clamp(28px,3vw,47px);font-style:italic;font-weight:400;letter-spacing:-.04em;margin:13px 0 9px;color:inherit}.service-description>p:not(.eyebrow){font-size:13px;max-width:370px;color:inherit;line-height:1.6}.service-description .text-link{font-size:10px;margin-top:9px;min-height:44px}.room-caption{position:absolute;left:3.4%;right:3.4%;bottom:24px;display:flex;justify-content:space-between;font-size:8px;color:inherit;opacity:.65}.material-room[data-world=someone]{background:#4b382b;color:#f3e3c9}.material-room[data-world=someone] h1{color:#f3e3c9}.material-room[data-world=someone] .material-seam{transform:skewX(-32deg) translateX(40px);background:#ad76461a}.material-room[data-world=business]{background:#343f2f;color:#ecebd7}.material-room[data-world=business] h1{color:#ecebd7}.material-room[data-world=business] .material-seam{background:#a9b98a12;transform:skewX(-32deg) translateX(-30px)}.material-room[data-world=stranger]{background:#20201c}.material-room:not([data-world=initial]) .service-opening .eyebrow{color:#c7bca8}.material-room:not([data-world=initial]) .service-choices{margin-top:30px}.material-room:not([data-world=initial]) .service-choices button{min-height:60px;font-size:22px}.material-room[data-world=stranger] .service-art{width:46%;right:2%;height:62%;top:21%}.service-nojs{padding:40px}.service-nojs article{padding:25px 0}
@media(prefers-reduced-motion:no-preference){.service-world:not([hidden]) .service-art{animation:material-open .8s cubic-bezier(.2,.8,.2,1) both}@keyframes material-open{from{clip-path:polygon(40% 0,55% 0,75% 100%,60% 100%);transform:translateY(25px) rotate(-4deg)}to{clip-path:polygon(-20% -20%,120% -20%,120% 120%,-20% 120%);transform:none}}}
@media(max-width:700px){.material-room{padding:32px 20px;height:auto;min-height:1060px}.service-opening .eyebrow{font-size:8px;margin-bottom:22px}h1{font-size:12vw}.service-choices{width:100%;margin-top:35px}.service-choices button{min-height:63px;font-size:20px}.service-choices button>span{font-size:8px}.initial-material{width:115%;height:420px;top:380px;right:-13%}.initial-note{left:20px;bottom:120px}.material-seam{inset:30% 12% 0 42%}.service-art{width:65%;height:320px;right:16%;top:440px}.service-description{left:20px;bottom:90px;width:calc(100% - 40px)}.service-description h2{font-size:33px}.service-description .eyebrow{font-size:7px}.service-description>p:not(.eyebrow){font-size:12px}.room-caption{left:20px;right:20px;font-size:7px;bottom:25px}.material-room:not([data-world=initial]) .service-choices{margin-top:35px}.material-room:not([data-world=initial]) .service-choices button{min-height:63px;font-size:20px}.material-room[data-world=stranger] .service-art{width:96%;right:0;height:370px;top:400px}}
</style>

