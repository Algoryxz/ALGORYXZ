---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/experience.css';

const founders = [
  {
    id: 'smarak',
    name: 'SMARAK',
    role: 'Engineering & Architecture',
    meta: 'CO-FOUNDER // ARCHITECTURE & EDGE SYSTEMS',
    focus: ['Distributed Systems', 'Edge Infrastructure', 'TypeScript', 'High-Framerate CSS/GL'],
    quote: 'If it takes more than a split second to react to a human touch, it is broken.',
    bio: 'Builds the unseen architecture. Treats every millisecond, byte, and network round-trip as a matter of craft. Smarak oversees edge deployments on Cloudflare, distributed state, and resilient systems designed to run without downtime or recurring SaaS bloat.',
    artifactType: 'engineering',
  },
  {
    id: 'deeptiman',
    name: 'DEEPTIMAN',
    role: 'Creative Direction & Design',
    meta: 'CO-FOUNDER // ART & CREATIVE DIRECTION',
    focus: ['Visual Identity', 'Editorial Typography', 'Spatial Hierarchy', 'Material Systems'],
    quote: 'A website should feel like an artifact you can hold in your mind long after closing the tab.',
    bio: 'Shapes the emotional weight, spatial hierarchy, and character of everything that appears on screen. Refuses generic templates, interchangeable SaaS gray cards, and aesthetic autopilot in favor of bespoke typographic craft and physical presence.',
    artifactType: 'design',
  },
  {
    id: 'akriti',
    name: 'AKRITI',
    role: 'Operations, Delivery & QA',
    meta: 'CO-FOUNDER // DELIVERY INTEGRITY & QA',
    focus: ['Physical Hardware QA', 'Scope Integrity', 'Client Onboarding', 'Encrypted Handover'],
    quote: 'Synthetic browser testing is easy. The real test is someone holding a phone on a bus in the rain.',
    bio: 'The studio’s uncompromising guardian of real-world experience. Akriti audits builds on physical phones under bright sun, variable network connections, and real thumb reach. Ensures scopes are honored, promises are kept, and handover is painless.',
    artifactType: 'delivery',
  },
];
---

<BaseLayout
  title="About — Three People. No Middle Layer."
  description="Meet the three founders of Algoryxz: Smarak, Deeptiman, and Akriti. Independent design and engineering from Bhubaneswar, Odisha."
>
  <div class="experience about-page">
    <!-- HERO -->
    <header class="about-hero">
      <p class="eyebrow">ABOUT / THE HUMANS BEHIND ALGORYXZ</p>
      <h1 class="editorial-title">THREE PEOPLE.<br /><span>NO MIDDLE LAYER.</span></h1>
      <div class="about-hero-foot">
        <p class="hero-manifesto">
          After the spatial rooms and material studies, this is the simple human truth. When you collaborate with Algoryxz, there are no account executives, no junior contractor relay chains, no communication lag. There are just three people who design, build, and deliver your thing.
        </p>
        <div class="hero-location">
          <span class="eyebrow">LOCATION</span>
          <strong>BHUBANESWAR, ODISHA, INDIA</strong>
        </div>
      </div>
    </header>

    <!-- FOUNDERS SECTION (INDIVIDUAL ASYMMETRIC COMPOSITIONS) -->
    <section class="founders-field" aria-label="The Three Founders">
      <!-- FOUNDER 01: SMARAK -->
      <article class="founder-zone zone-smarak" id="founder-smarak">
        <div class="founder-copy">
          <span class="eyebrow">{founders[0].meta}</span>
          <h2 class="founder-graphic-name">{founders[0].name}</h2>
          <p class="founder-role-title">{founders[0].role}</p>
          <blockquote class="founder-quote">“{founders[0].quote}”</blockquote>
          <p class="founder-narrative">{founders[0].bio}</p>
          <div class="founder-focus-row">
            {founders[0].focus.map(item => (
              <span class="focus-chip">{item}</span>
            ))}
          </div>
        </div>
        <div class="founder-artifact-wrap" aria-hidden="true">
          <div class="human-artifact artifact-smarak">
            <div class="artifact-frame">
              <div class="contact-sheet-meta">
                <span>35MM FILM // FRAME 01A</span>
                <span>ISO 400</span>
              </div>
              <div class="blueprint-canvas">
                <div class="blueprint-grid"></div>
                <div class="code-scraps">
                  <code>const edge = new EdgeRouter();</code>
                  <code>// 0 latency cutover verified</code>
                  <code>dns.bind('origin', 100);</code>
                </div>
                <div class="schematic-crosshair"></div>
                <span class="artifact-caption">ARCHITECTURAL SCHEMATIC / 001</span>
              </div>
              <div class="frame-bottom-marks">
                <span>KODAK SAFETY FILM</span>
                <span>+ 0.12 EV</span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- FOUNDER 02: DEEPTIMAN (FLIPPED COMPOSITION) -->
      <article class="founder-zone zone-deeptiman" id="founder-deeptiman">
        <div class="founder-artifact-wrap" aria-hidden="true">
          <div class="human-artifact artifact-deeptiman">
            <div class="artifact-frame frame-warm">
              <div class="contact-sheet-meta">
                <span>TRI-X PAN // FRAME 02B</span>
                <span>EXP 24</span>
              </div>
              <div class="type-specimen-canvas">
                <div class="specimen-crop-tl"></div>
                <div class="specimen-crop-br"></div>
                <p class="specimen-title">Form follows<br /><em>feeling.</em></p>
                <div class="specimen-rules"></div>
                <div class="swatch-strip">
                  <div class="swatch sw-1"></div>
                  <div class="swatch sw-2"></div>
                  <div class="swatch sw-3"></div>
                </div>
                <span class="artifact-caption">MATERIAL STUDY / TYPE & PAPER</span>
              </div>
              <div class="frame-bottom-marks">
                <span>PANTONE WARM GRAPHITE</span>
                <span>36PT / 42PT</span>
              </div>
            </div>
          </div>
        </div>
        <div class="founder-copy">
          <span class="eyebrow">{founders[1].meta}</span>
          <h2 class="founder-graphic-name">{founders[1].name}</h2>
          <p class="founder-role-title">{founders[1].role}</p>
          <blockquote class="founder-quote">“{founders[1].quote}”</blockquote>
          <p class="founder-narrative">{founders[1].bio}</p>
          <div class="founder-focus-row">
            {founders[1].focus.map(item => (
              <span class="focus-chip">{item}</span>
            ))}
          </div>
        </div>
      </article>

      <!-- FOUNDER 03: AKRITI -->
      <article class="founder-zone zone-akriti" id="founder-akriti">
        <div class="founder-copy">
          <span class="eyebrow">{founders[2].meta}</span>
          <h2 class="founder-graphic-name">{founders[2].name}</h2>
          <p class="founder-role-title">{founders[2].role}</p>
          <blockquote class="founder-quote">“{founders[2].quote}”</blockquote>
          <p class="founder-narrative">{founders[2].bio}</p>
          <div class="founder-focus-row">
            {founders[2].focus.map(item => (
              <span class="focus-chip">{item}</span>
            ))}
          </div>
        </div>
        <div class="founder-artifact-wrap" aria-hidden="true">
          <div class="human-artifact artifact-akriti">
            <div class="artifact-frame frame-audit">
              <div class="contact-sheet-meta">
                <span>DEVICE AUDIT // PHYSICAL_QA</span>
                <span>PASS 100%</span>
              </div>
              <div class="caliper-canvas">
                <div class="caliper-target"></div>
                <div class="audit-checklist">
                  <div class="chk"><span>[✓]</span> iOS Safari 390×844</div>
                  <div class="chk"><span>[✓]</span> Android Chrome 412×915</div>
                  <div class="chk"><span>[✓]</span> Zero Hostage Assets</div>
                  <div class="chk"><span>[✓]</span> Encrypted Bitwarden Send</div>
                </div>
                <span class="artifact-stamp">AUDITED & CLEARED</span>
              </div>
              <div class="frame-bottom-marks">
                <span>44PX MIN TAP TARGET</span>
                <span>PHYSICAL VERIFICATION</span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- SHARED OVERLAPPING RESPONSIBILITIES SECTION -->
    <section class="shared-discipline" aria-labelledby="shared-heading">
      <div class="shared-backdrop" aria-hidden="true"></div>
      <div class="shared-content">
        <p class="eyebrow">THE OVERLAP // NO SILOS</p>
        <h2 id="shared-heading" class="shared-monument">
          <span>DESIGN</span>
          <span class="symbol">×</span>
          <span>ENGINEERING</span>
          <span class="symbol">×</span>
          <span>DELIVERY</span>
        </h2>
        <div class="shared-narrative-grid">
          <div class="narrative-col">
            <h3>No translation loss</h3>
            <p>
              Traditional agencies pass client briefs across three departments and two subcontracting layers. By the time code is written, the initial emotional intent has evaporated. Here, the designer understands edge caching, the architect cares about typographic leading, and the delivery lead verifies every pixel on physical glass.
            </p>
          </div>
          <div class="narrative-col">
            <h3>Direct founder access</h3>
            <p>
              When you message Algoryxz, your note doesn't get logged into a ticket queue by an account executive. You are in direct conversation with Smarak, Deeptiman, and Akriti. Every decision is made with the founders who are actually writing your code and shaping your layouts.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- BHUBANESWAR ORIGIN & STUDIO INVITATION -->
    <section class="origin-section" aria-labelledby="origin-heading">
      <div class="origin-inner">
        <div class="origin-copy">
          <p class="eyebrow">STUDIO ROOTS</p>
          <h2 id="origin-heading">Bhubaneswar / Odisha / The Internet</h2>
          <p>
            We deliberately built Algoryxz in Bhubaneswar. Away from the homogeneous rush of agency corridors, we have the quiet space to build deliberate, enduring work.
          </p>
          <p>
            Our clients are people celebrating once-in-a-lifetime occasions, founders giving their business an unforgettable digital presence, and people with stranger ideas that deserve a shape.
          </p>
        </div>
        <div class="origin-action">
          <div class="origin-card">
            <span class="eyebrow">HAVE AN IDEA?</span>
            <p class="origin-cta-text">Work directly with the three founders.</p>
            <div class="origin-links">
              <a href="/work" class="text-link">VIEW ARCHIVE <span>↗</span></a>
              <a href="/contact" class="metal-link">START A CONVERSATION <span>↗</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Subtle interactive parallax on human artifacts
  function initAboutParallax() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const fine = window.matchMedia('(pointer: fine)');
    if (reduced.matches || !fine.matches) return;

    const artifacts = document.querySelectorAll<HTMLElement>('.human-artifact');
    window.addEventListener('pointermove', (e: PointerEvent) => {
      const rx = (e.clientX / window.innerWidth - 0.5) * 8;
      const ry = (e.clientY / window.innerHeight - 0.5) * 8;
      artifacts.forEach((art, i) => {
        const factor = (i % 2 === 0) ? 1 : -1;
        art.style.transform = `translate3d(${rx * factor}px, ${ry * factor}px, 0) rotate(${rx * 0.2 * factor}deg)`;
      });
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutParallax);
  } else {
    initAboutParallax();
  }
</script>

<style>
  .about-page {
    overflow-x: clip;
    min-height: 100svh;
  }

  /* HERO */
  .about-hero {
    padding: 70px 3.4vw 70px;
    border-bottom: 1px solid var(--studio-rule);
    background: radial-gradient(ellipse at 80% 25%, #2a221a40, transparent 55%), var(--studio-ink);
  }

  .about-hero .eyebrow {
    margin-bottom: 32px;
  }

  .about-hero h1 {
    font-size: clamp(55px, 8vw, 130px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .about-hero h1 span {
    color: #bfa996;
  }

  .about-hero-foot {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 4vw;
    margin-top: 50px;
    align-items: end;
  }

  .hero-manifesto {
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.65;
    color: var(--studio-paper);
    max-width: 680px;
  }

  .hero-location {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-left: 1px solid var(--studio-rule);
    padding-left: 24px;
  }

  .hero-location strong {
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--studio-ember);
  }

  /* FOUNDER FIELDS */
  .founders-field {
    padding: 40px 0;
  }

  .founder-zone {
    padding: 80px 4vw;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 6vw;
    align-items: center;
    border-bottom: 1px solid var(--studio-rule);
    position: relative;
  }

  .zone-deeptiman {
    grid-template-columns: 1fr 1.1fr;
    background: radial-gradient(ellipse at 20% 50%, #29241b30, transparent 60%);
  }

  .zone-smarak {
    background: radial-gradient(ellipse at 80% 50%, #1c211f30, transparent 60%);
  }

  .zone-akriti {
    background: radial-gradient(ellipse at 75% 50%, #25201930, transparent 60%);
  }

  .founder-copy {
    max-width: 580px;
  }

  .founder-copy .eyebrow {
    color: var(--studio-ember);
    margin-bottom: 16px;
    display: block;
  }

  .founder-graphic-name {
    font-size: clamp(52px, 8.5vw, 115px);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.07em;
    color: var(--studio-paper);
    margin-bottom: 12px;
  }

  .founder-role-title {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #b8b0a2;
    margin-bottom: 24px;
  }

  .founder-quote {
    font-family: Georgia, serif;
    font-size: clamp(16px, 1.8vw, 24px);
    font-style: italic;
    line-height: 1.35;
    color: #e3d2bf;
    margin: 0 0 24px;
    padding-left: 18px;
    border-left: 2px solid var(--studio-ember);
  }

  .founder-narrative {
    font-size: 14px;
    line-height: 1.7;
    color: var(--studio-muted);
    margin-bottom: 28px;
  }

  .founder-focus-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .focus-chip {
    font: 9px var(--font-family-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 12px;
    background: #191816;
    border: 1px solid #ffffff12;
    color: #a49c90;
  }

  /* DELIBERATELY CRAFTED ARTIFACT FRAMES */
  .founder-artifact-wrap {
    position: relative;
    width: 100%;
    min-height: 440px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .human-artifact {
    position: relative;
    width: 320px;
    height: 400px;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .artifact-frame {
    position: absolute;
    inset: 0;
    background: #141412;
    border: 1px solid #c7805545;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.65);
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .contact-sheet-meta, .frame-bottom-marks {
    display: flex;
    justify-content: space-between;
    font: 8px var(--font-family-mono);
    letter-spacing: 0.12em;
    color: #7d7568;
    text-transform: uppercase;
  }

  /* SMARAK BLUEPRINT CANVAS */
  .blueprint-canvas {
    position: relative;
    flex: 1;
    margin: 14px 0;
    background: #101211;
    border: 1px solid #ffffff10;
    padding: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .blueprint-grid {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, #c7805520 1px, transparent 1px);
    background-size: 16px 16px;
    opacity: 0.4;
  }

  .code-scraps {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .code-scraps code {
    font: 9px var(--font-family-mono);
    color: #b2aba0;
    background: #0d0e0d;
    padding: 4px 8px;
    border-left: 2px solid var(--studio-ember);
  }

  .schematic-crosshair {
    position: absolute;
    right: 20px;
    bottom: 35px;
    width: 40px;
    height: 40px;
    border: 1px solid #c7805540;
    border-radius: 50%;
  }

  .schematic-crosshair::before, .schematic-crosshair::after {
    content: '';
    position: absolute;
    background: #c7805550;
  }
  .schematic-crosshair::before { inset: -4px 19px; width: 1px; }
  .schematic-crosshair::after { inset: 19px -4px; height: 1px; }

  .artifact-caption {
    position: relative;
    z-index: 2;
    font: 8px var(--font-family-mono);
    color: var(--studio-ember);
    letter-spacing: 0.12em;
  }

  /* DEEPTIMAN SPECIMEN CANVAS */
  .frame-warm {
    background: #191612;
    border-color: #d18d5e50;
  }

  .type-specimen-canvas {
    position: relative;
    flex: 1;
    margin: 14px 0;
    background: #e8ded0;
    color: #1a1714;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.15);
  }

  .specimen-title {
    font-size: 32px;
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: 500;
  }

  .specimen-title em {
    font-family: Georgia, serif;
    font-weight: 400;
    font-style: italic;
    color: #8c4e2d;
  }

  .specimen-rules {
    height: 12px;
    background: repeating-linear-gradient(90deg, #1a1714 0 2px, transparent 2px 6px);
    opacity: 0.7;
    margin: 15px 0;
  }

  .swatch-strip {
    display: flex;
    gap: 6px;
    height: 18px;
  }

  .swatch {
    flex: 1;
    border: 1px solid #1a171430;
  }
  .sw-1 { background: #191816; }
  .sw-2 { background: #ba5031; }
  .sw-3 { background: #cbbba6; }

  .specimen-crop-tl, .specimen-crop-br {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 1px solid #1a171450;
  }
  .specimen-crop-tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; }
  .specimen-crop-br { bottom: 6px; right: 6px; border-left: 0; border-top: 0; }

  .type-specimen-canvas .artifact-caption {
    color: #5c422c;
  }

  /* AKRITI CALIPER CANVAS */
  .frame-audit {
    background: #141715;
    border-color: #6d846950;
  }

  .caliper-canvas {
    position: relative;
    flex: 1;
    margin: 14px 0;
    background: #0f1311;
    border: 1px solid #4a614830;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .audit-checklist {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font: 10px var(--font-family-mono);
    color: #c9c3b8;
  }

  .audit-checklist .chk span {
    color: #68b879;
    font-weight: 700;
    margin-right: 6px;
  }

  .artifact-stamp {
    align-self: flex-start;
    padding: 4px 10px;
    border: 1px solid #68b87980;
    color: #8ce29e;
    font: 8px var(--font-family-mono);
    letter-spacing: 0.12em;
    transform: rotate(-3deg);
  }

  /* SHARED DISCIPLINE */
  .shared-discipline {
    padding: 120px 4vw;
    background: #0d0d0c;
    border-bottom: 1px solid var(--studio-rule);
    position: relative;
  }

  .shared-monument {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 24px;
    font-size: clamp(38px, 6.5vw, 105px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.06em;
    margin: 30px 0 60px;
    color: var(--studio-paper);
  }

  .shared-monument .symbol {
    color: var(--studio-ember);
    font-weight: 300;
  }

  .shared-narrative-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5vw;
  }

  .narrative-col h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
    color: var(--studio-paper);
  }

  .narrative-col p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--studio-muted);
  }

  /* ORIGIN SECTION */
  .origin-section {
    padding: 100px 4vw 80px;
    background: var(--studio-ink);
  }

  .origin-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 6vw;
    align-items: center;
  }

  .origin-copy h2 {
    font-size: clamp(36px, 4.5vw, 70px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin: 16px 0 28px;
  }

  .origin-copy p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--studio-muted);
    margin-bottom: 18px;
    max-width: 580px;
  }

  .origin-card {
    padding: 40px;
    background: #171614;
    border: 1px solid var(--studio-rule);
  }

  .origin-cta-text {
    font-size: 20px;
    font-weight: 500;
    margin: 12px 0 30px;
    color: var(--studio-paper);
  }

  .origin-links {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .about-hero-foot {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .hero-location {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--studio-rule);
      padding-top: 20px;
    }

    .founder-zone {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 60px 20px;
    }

    .zone-deeptiman {
      grid-template-columns: 1fr;
    }

    /* Keep text first on mobile across all zones */
    .zone-deeptiman .founder-copy {
      order: 1;
    }
    .zone-deeptiman .founder-artifact-wrap {
      order: 2;
    }

    .founder-artifact-wrap {
      min-height: 360px;
    }

    .shared-narrative-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .origin-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .origin-card {
      padding: 28px 20px;
    }
  }

