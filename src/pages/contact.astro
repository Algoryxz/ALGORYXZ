---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/experience.css';

const founders = [
  {
    id: 'smarak',
    name: 'SMARAK PADHI',
    role: 'Engineering · Architecture · Custom Systems',
    number: '918018769496',
    actionLabel: 'WHATSAPP SMARAK',
    msg: "Hi Smarak, I found you through your website and have an engineering / systems idea I'd like to make.",
  },
  {
    id: 'deeptiman',
    name: 'DEEPTIMAN',
    role: 'Creative Direction · Design · Brand Experiences',
    number: '917684984788',
    actionLabel: 'WHATSAPP DEEPTIMAN',
    msg: "Hi Deeptiman, I found you through your website and have a brand / design idea I'd like to make.",
  },
  {
    id: 'akriti',
    name: 'AKRITI',
    role: 'Operations · Delivery · QA / General Enquiries',
    number: '917205053185',
    actionLabel: 'WHATSAPP AKRITI',
    msg: "Hi Akriti, I found you through your website and have something I'd like to make.",
  },
];
---

<BaseLayout
  title="Contact — Tell Us What You Want To Make"
  description="Direct founder access. Talk with Smarak, Deeptiman, or Akriti via WhatsApp or email. Zero account managers, zero middlemen."
>
  <div class="experience contact-page">
    <!-- AMBIENT HALO -->
    <div class="material-halo" aria-hidden="true"></div>

    <div class="contact-shell">
      <!-- HERO -->
      <header class="contact-hero">
        <p class="eyebrow">DIRECT INQUIRY // THREE FOUNDERS</p>
        <h1 class="editorial-title">TELL US<br />WHAT YOU<br /><span>WANT TO MAKE.</span></h1>
        <p class="hero-manifesto">
          No account executives. No junior contractor relay chains. When you reach out to Algoryxz, you speak directly with the three people who architect, design, and deliver your project.
        </p>
      </header>

      <!-- THREE DIRECT FOUNDER PATHWAYS -->
      <section class="founder-channels" aria-label="Direct founder channels">
        <p class="eyebrow section-tag">01 // CHOOSE YOUR DIRECT PATH</p>
        
        <div class="channel-list">
          {founders.map(f => (
            <div class="channel-row" id={`channel-${f.id}`}>
              <div class="channel-identity">
                <h2 class="channel-name">{f.name}</h2>
                <p class="channel-role">{f.role}</p>
              </div>
              <div class="channel-action">
                <a
                  href={`https://wa.me/${f.number}?text=${encodeURIComponent(f.msg)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="metal-link channel-btn"
                  aria-label={`${f.actionLabel} on WhatsApp`}
                >
                  {f.actionLabel} <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- GENERAL INQUIRY & STUDIO PRESENCE -->
      <section class="general-channels" aria-label="General studio contact">
        <div class="general-grid">
          <div class="general-card card-email">
            <span class="eyebrow">NOT SURE WHO TO TALK TO?</span>
            <h3>teamalgoryxz@gmail.com</h3>
            <p>Send your note directly to the founders.</p>
            <a
              href="mailto:teamalgoryxz@gmail.com?subject=Project%20Inquiry%20%E2%80%94%20Algoryxz"
              class="text-link general-link"
            >
              EMAIL THE STUDIO <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="general-card card-social">
            <span class="eyebrow">FOLLOW THE STUDIO</span>
            <h3>@algoryxz_ux_</h3>
            <p>Work in progress, typographic studies, and release dispatches on Instagram.</p>
            <a
              href="https://www.instagram.com/algoryxz_ux_/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link general-link"
            >
              OPEN INSTAGRAM <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <!-- FAST IDEA DRAFTER (ZERO-FAKE, PURE FUNCTIONAL BRIDGE) -->
      <section class="idea-drafter-section" aria-label="Draft your idea">
        <div class="drafter-header">
          <p class="eyebrow">02 // HAVE AN IDEA READY?</p>
          <h2 class="drafter-title">Draft it here. Send it directly.</h2>
          <p class="drafter-sub">
            Type your thoughts below. When ready, tap WhatsApp or Email to carry your note directly into a conversation with us.
          </p>
        </div>

        <div class="drafter-box">
          <label for="draft-note" class="eyebrow drafter-label">WHAT DO YOU WANT TO MAKE?</label>
          <textarea
            id="draft-note"
            rows="4"
            class="drafter-textarea"
            placeholder="A quiet digital home for our bakery... A living memory archive for a wedding in December... A custom tool that doesn't exist yet..."
          ></textarea>

          <div class="drafter-meta-row">
            <div class="drafter-author-field">
              <label for="draft-author" class="eyebrow drafter-label">YOUR NAME OR CONTACT (OPTIONAL)</label>
              <input
                type="text"
                id="draft-author"
                class="drafter-input"
                placeholder="e.g. Maya Roy / @maya / +91..."
              />
            </div>
          </div>

          <div class="drafter-actions">
            <button type="button" id="btn-draft-wa" class="metal-link send-action-btn">
              SEND VIA WHATSAPP <span aria-hidden="true">→</span>
            </button>
            <a
              id="btn-draft-mail"
              href="mailto:teamalgoryxz@gmail.com?subject=Project%20Idea%20%E2%80%94%20Algoryxz"
              class="metal-link send-action-btn alt-btn"
            >
              SEND VIA EMAIL <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="drafter-assurance">
            Opens directly in your WhatsApp or email client with your drafted note intact. No fake databases or CRM queues.
          </p>
        </div>
      </section>

      <!-- STUDIO COLOPHON FOOTER -->
      <footer class="contact-colophon">
        <div class="colophon-block">
          <span class="eyebrow">STUDIO ADDRESS</span>
          <p>Bhubaneswar, Odisha, India<br />Distributed across the internet</p>
        </div>
        <div class="colophon-block">
          <span class="eyebrow">DIRECT INBOX</span>
          <a href="mailto:teamalgoryxz@gmail.com" class="colophon-mail">teamalgoryxz@gmail.com</a>
        </div>
        <div class="colophon-block">
          <span class="eyebrow">FOUNDER COMMITMENT</span>
          <p>Zero middle layer · Fixed scopes · Your domain stays yours.</p>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>

<script>
  function initContactDrafter() {
    const noteEl = document.querySelector<HTMLTextAreaElement>('#draft-note');
    const authorEl = document.querySelector<HTMLInputElement>('#draft-author');
    const waBtn = document.querySelector<HTMLButtonElement>('#btn-draft-wa');
    const mailBtn = document.querySelector<HTMLAnchorElement>('#btn-draft-mail');

    if (!noteEl || !waBtn || !mailBtn) return;

    function buildMessage(): string {
      const note = noteEl?.value.trim() || '';
      const author = authorEl?.value.trim() || '';
      if (!note) {
        return "Hi Algoryxz, I found you through your website and have something I'd like to make.";
      }
      if (author) {
        return `Hi Algoryxz, I'm ${author}. I want to make:\n\n${note}`;
      }
      return `Hi Algoryxz, I want to make:\n\n${note}`;
    }

    function updateLinks() {
      const text = buildMessage();
      // WhatsApp targets Akriti (Operations · Delivery · QA / General Enquiries) by default for new project notes
      const waUrl = `https://wa.me/917205053185?text=${encodeURIComponent(text)}`;
      waBtn?.setAttribute('data-target-url', waUrl);

      const mailSubject = encodeURIComponent('Project Inquiry — Algoryxz');
      const mailBody = encodeURIComponent(text);
      const mailUrl = `mailto:teamalgoryxz@gmail.com?subject=${mailSubject}&body=${mailBody}`;
      mailBtn?.setAttribute('href', mailUrl);
    }

    noteEl.addEventListener('input', updateLinks);
    if (authorEl) authorEl.addEventListener('input', updateLinks);

    waBtn.addEventListener('click', () => {
      updateLinks();
      const targetUrl = waBtn.getAttribute('data-target-url') || 'https://wa.me/917205053185';
      window.open(targetUrl, '_blank', 'noopener,noreferrer');
    });

    updateLinks();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactDrafter);
  } else {
    initContactDrafter();
  }
</script>

<style>
  .contact-page {
    position: relative;
    min-height: 100svh;
    overflow-x: clip;
    background: #10100f;
    color: var(--studio-paper);
  }

  .material-halo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.65;
    background: radial-gradient(ellipse at 85% 15%, #3e2a1b40, transparent 65%);
    z-index: 0;
  }

  .contact-shell {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    padding: 70px 4vw 100px;
  }

  /* HERO */
  .contact-hero {
    margin-bottom: 90px;
    border-bottom: 1px solid var(--studio-rule);
    padding-bottom: 60px;
  }

  .contact-hero .eyebrow {
    margin-bottom: 32px;
    color: var(--studio-ember);
  }

  .editorial-title {
    font-size: clamp(56px, 8.5vw, 135px);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.065em;
    margin-bottom: 36px;
  }

  .editorial-title span {
    color: var(--studio-ember);
  }

  .hero-manifesto {
    font-size: clamp(15px, 1.35vw, 18px);
    line-height: 1.65;
    color: var(--studio-muted);
    max-width: 680px;
  }

  /* SECTION LABELS */
  .section-tag {
    margin-bottom: 24px;
    color: var(--studio-muted);
  }

  /* THREE FOUNDER DIRECT CHANNELS */
  .founder-channels {
    margin-bottom: 90px;
  }

  .channel-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--studio-rule);
  }

  .channel-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 40px 0;
    border-bottom: 1px solid var(--studio-rule);
    transition: border-color 0.25s ease;
  }

  .channel-row:hover {
    border-color: #c7805560;
  }

  .channel-identity {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .channel-name {
    font-family: Georgia, serif;
    font-size: clamp(28px, 3.8vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--studio-paper);
  }

  .channel-role {
    font: 12px var(--font-family-mono);
    letter-spacing: 0.08em;
    color: #ba714a;
    text-transform: uppercase;
  }

  .channel-btn {
    min-height: 48px;
    padding: 14px 28px;
    font-size: 12px;
    white-space: nowrap;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  /* GENERAL CHANNELS */
  .general-channels {
    margin-bottom: 100px;
  }

  .general-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .general-card {
    padding: 40px 36px;
    background: #151413;
    border: 1px solid var(--studio-rule);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 240px;
    transition: border-color 0.25s ease;
  }

  .general-card:hover {
    border-color: #c7805560;
  }

  .general-card .eyebrow {
    margin-bottom: 16px;
    color: var(--studio-muted);
  }

  .general-card h3 {
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--studio-paper);
    margin-bottom: 12px;
    word-break: break-all;
  }

  .general-card p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--studio-muted);
    margin-bottom: 28px;
  }

  .general-link {
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }

  /* IDEA DRAFTER */
  .idea-drafter-section {
    margin-bottom: 100px;
    border-top: 1px solid var(--studio-rule);
    padding-top: 80px;
  }

  .drafter-header {
    margin-bottom: 40px;
    max-width: 680px;
  }

  .drafter-header .eyebrow {
    margin-bottom: 20px;
    color: var(--studio-ember);
  }

  .drafter-title {
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin-bottom: 16px;
  }

  .drafter-sub {
    font-size: 14px;
    line-height: 1.65;
    color: var(--studio-muted);
  }

  .drafter-box {
    background: #141312;
    border: 1px solid var(--studio-rule);
    padding: 44px;
    position: relative;
  }

  .drafter-label {
    display: block;
    margin-bottom: 16px;
    color: #ba714a;
  }

  .drafter-textarea {
    width: 100%;
    background: #0d0d0c;
    border: 1px solid #ffffff18;
    color: var(--studio-paper);
    font-family: Georgia, serif;
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.5;
    padding: 24px;
    resize: vertical;
    min-height: 150px;
    box-sizing: border-box;
    transition: border-color 0.25s ease;
  }

  .drafter-textarea:focus {
    outline: none;
    border-color: var(--studio-ember);
    box-shadow: 0 0 20px rgba(199, 128, 85, 0.15);
  }

  .drafter-textarea::placeholder {
    color: #6a6459;
    font-style: italic;
  }

  .drafter-meta-row {
    margin-top: 24px;
    margin-bottom: 32px;
  }

  .drafter-author-field {
    width: 100%;
    max-width: 480px;
  }

  .drafter-input {
    width: 100%;
    background: #0d0d0c;
    border: 1px solid #ffffff18;
    color: var(--studio-paper);
    font-family: var(--font-family-mono);
    font-size: 13px;
    padding: 14px 18px;
    box-sizing: border-box;
    min-height: 48px;
    transition: border-color 0.25s ease;
  }

  .drafter-input:focus {
    outline: none;
    border-color: var(--studio-ember);
  }

  .drafter-input::placeholder {
    color: #6a6459;
  }

  .drafter-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .send-action-btn {
    min-height: 48px;
    padding: 14px 32px;
    font-size: 12px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .alt-btn {
    background: #23201d;
    border-color: #ffffff20;
  }

  .alt-btn:hover {
    border-color: var(--studio-ember);
  }

  .drafter-assurance {
    font-size: 12px;
    color: #8c8375;
    line-height: 1.5;
  }

  /* COLOPHON */
  .contact-colophon {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    border-top: 1px solid var(--studio-rule);
    padding-top: 48px;
  }

  .colophon-block .eyebrow {
    display: block;
    margin-bottom: 12px;
    color: var(--studio-muted);
  }

  .colophon-block p,
  .colophon-block a {
    font-size: 13px;
    line-height: 1.6;
    color: var(--studio-muted);
  }

  .colophon-mail {
    color: var(--studio-paper) !important;
    text-decoration: underline;
    text-underline-offset: 4px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .colophon-mail:hover {
    color: var(--studio-ember) !important;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .channel-row {
      grid-template-columns: 1fr;
      align-items: flex-start;
      gap: 20px;
    }
    .general-grid {
      grid-template-columns: 1fr;
    }
    .contact-colophon {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .contact-shell {
      padding: 50px 20px 70px;
    }
    .contact-hero {
      margin-bottom: 60px;
      padding-bottom: 40px;
    }
    .drafter-box {
      padding: 24px 18px;
    }
    .drafter-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .send-action-btn {
      width: 100%;
      justify-content: center;
    }
    .channel-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .material-halo {
      display: none;
    }
  }
</style>
