---
import TheatreLayout from '../../layouts/TheatreLayout.astro';
import MaterialArtifact from '../../components/MaterialArtifact.astro';
import { theatreSeats, premiumLodgeData } from '../../data/theatre-projects';
import '../../styles/theatre-cinematic.css';

const seat000 = theatreSeats.find((s) => s.id === '000')!;
const seat001 = theatreSeats.find((s) => s.id === '001')!;
const seat002 = theatreSeats.find((s) => s.id === '002')!;
const reservedSeats = theatreSeats.filter((s) => s.status === 'RESERVED');
---

<TheatreLayout title="Algoryxz Cinema — 2.5D Private Screening Room & Archive">
  <!-- Minimal Escape Hatch to Approved Work Page -->
  <a href="/work" class="theatre-escape" aria-label="Return to approved work archive">
    <span class="theatre-escape-arrow">&larr;</span>
    <span>Work / Archive</span>
  </a>

  <!-- Header Marquee & Printed Programme Trigger -->
  <header class="theatre-marquee">
    <div class="theatre-marquee-badge">
      ALGORYXZ PICTURES &middot; <strong>HOUSE 01 &middot; PRIVATE SCREENING</strong>
    </div>
    <button
      type="button"
      class="theatre-programme-toggle"
      id="theatre-programme-btn"
      aria-controls="theatre-programme-drawer"
      aria-expanded="false"
      aria-label="Open tonight's printed programme"
    >
      <span>&equiv;</span>
      <span>Programme</span>
    </button>
  </header>

  <!-- 2.5D Spatial Scroll Track (Desktop Spatial Movement) -->
  <div class="theatre-scroll-track" id="theatre-track">
    <main class="theatre-stage" id="theatre-stage">
      
      <!-- SVG Projector Beam & Atmospheric Dust -->
      <svg class="theatre-beam-svg" id="theatre-beam" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="beamGradient" x1="50%" y1="100%" x2="50%" y2="0%">
            <stop offset="0%" stop-color="#FFE7BC" stop-opacity="0.22" />
            <stop offset="45%" stop-color="#FFE7BC" stop-opacity="0.08" />
            <stop offset="100%" stop-color="#FFE7BC" stop-opacity="0" />
          </linearGradient>
          <radialGradient id="bloomGradient" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#FFE7BC" stop-opacity="0.14" />
            <stop offset="100%" stop-color="#FFE7BC" stop-opacity="0" />
          </radialGradient>
        </defs>
        <!-- Projected Cone -->
        <polygon points="460,600 540,600 920,100 80,100" fill="url(#beamGradient)" />
        <ellipse cx="500" cy="160" rx="420" ry="140" fill="url(#bloomGradient)" />
        
        <!-- Static Dust Particle Motes -->
        <circle cx="480" cy="380" r="1.5" fill="#FFE7BC" opacity="0.45" />
        <circle cx="525" cy="310" r="1.2" fill="#FFE7BC" opacity="0.35" />
        <circle cx="440" cy="240" r="1.8" fill="#FFE7BC" opacity="0.5" />
        <circle cx="565" cy="420" r="1.1" fill="#FFE7BC" opacity="0.4" />
        <circle cx="505" cy="210" r="1.4" fill="#FFE7BC" opacity="0.3" />
      </svg>

      <!-- PLANE 0: Proscenium Arch & Main Cinema Projection Screen -->
      <section class="theatre-proscenium" aria-label="Main projected screening">
        <div class="theatre-proscenium-arch">
          <div class="theatre-screen-canvas" id="theatre-screen">

            <!-- Screening 000: Studio Architecture -->
            <article class="theatre-projection-slide is-active" data-slide-id="000" id="slide-000">
              <div class="theatre-slide-info">
                <div class="theatre-screen-colophon">
                  <span>NOW SCREENING &middot; 000</span>
                  <span class="theatre-screen-status status-INTERNAL">INTERNAL</span>
                </div>
                <h1 class="theatre-screen-title">{seat000.label}</h1>
                <p class="theatre-screen-desc">{seat000.shortDescription}</p>
                <a href={seat000.projectHref} class="theatre-screen-cta" id="cta-000">
                  <span>ENTER PROJECT</span>
                  <span>&nearr;</span>
                </a>
              </div>
              <div class="theatre-slide-visual" aria-hidden="true">
                <MaterialArtifact kind="structure" />
              </div>
            </article>

            <!-- Screening 001: Celebrations -->
            <article class="theatre-projection-slide" data-slide-id="001" id="slide-001">
              <div class="theatre-slide-info">
                <div class="theatre-screen-colophon">
                  <span>NOW SCREENING &middot; 001</span>
                  <span class="theatre-screen-status status-CONCEPT">CONCEPT STUDY</span>
                </div>
                <h2 class="theatre-screen-title">{seat001.label}</h2>
                <p class="theatre-screen-desc">{seat001.shortDescription}</p>
                <a href={seat001.projectHref} class="theatre-screen-cta" id="cta-001">
                  <span>ENTER PROJECT</span>
                  <span>&nearr;</span>
                </a>
              </div>
              <div class="theatre-slide-visual" aria-hidden="true">
                <MaterialArtifact kind="someone" />
              </div>
            </article>

            <!-- Screening 002: Business & Brand -->
            <article class="theatre-projection-slide" data-slide-id="002" id="slide-002">
              <div class="theatre-slide-info">
                <div class="theatre-screen-colophon">
                  <span>NOW SCREENING &middot; 002</span>
                  <span class="theatre-screen-status status-CONCEPT">CONCEPT STUDY</span>
                </div>
                <h2 class="theatre-screen-title">{seat002.label}</h2>
                <p class="theatre-screen-desc">{seat002.shortDescription}</p>
                <a href={seat002.projectHref} class="theatre-screen-cta" id="cta-002">
                  <span>ENTER PROJECT</span>
                  <span>&nearr;</span>
                </a>
              </div>
              <div class="theatre-slide-visual" aria-hidden="true">
                <MaterialArtifact kind="business" />
              </div>
            </article>

            <!-- Screening: Premium Rear Lodge -->
            <article class="theatre-projection-slide theatre-slide-lodge" data-slide-id="LODGE" id="slide-LODGE">
              <div class="theatre-slide-info">
                <div class="theatre-screen-colophon">
                  <span>REAR LODGE &middot; AVAILABLE</span>
                  <span class="theatre-screen-status status-PREMIUM">NEXT COMMISSION</span>
                </div>
                <h2 class="theatre-screen-title">{premiumLodgeData.title}</h2>
                <p class="theatre-screen-desc">{premiumLodgeData.subtitle} {premiumLodgeData.copy}</p>
                <a href={premiumLodgeData.ctaHref} class="theatre-screen-cta" id="cta-LODGE">
                  <span>{premiumLodgeData.ctaText}</span>
                  <span>&nearr;</span>
                </a>
              </div>
              <div class="theatre-slide-visual" aria-hidden="true">
                <MaterialArtifact kind="structure" />
              </div>
            </article>

          </div>
        </div>
      </section>

      <!-- PLANE 1, 2, 3, 4: Physical 2.5D Auditorium & Seat-Back Archive -->
      <nav class="theatre-auditorium" aria-label="Physical auditorium seat-back project archive">
        <div class="theatre-aisle-guide" aria-hidden="true"></div>

        <!-- PLANE 1: Distant Background Seating Row (Silhouette / Perspective Compression) -->
        <div class="theatre-row-distant" aria-hidden="true">
          <div class="theatre-seat-silhouette"></div>
          <div class="theatre-seat-silhouette"></div>
          <div class="theatre-seat-silhouette"></div>
          <div class="theatre-seat-silhouette"></div>
          <div class="theatre-seat-silhouette"></div>
          <div class="theatre-seat-silhouette"></div>
        </div>

        <!-- PLANE 2 & 3: Active Archive Seat-Back Bank -->
        <div class="theatre-seating-bank">
          
          <!-- Row A & Row B Integrated Archive Bank -->
          <div class="theatre-seat-row">
            
            <!-- Left Flank: Concept 001 & Reserved C1 -->
            <div class="theatre-seat-row-left">
              <!-- Seat C1: Reserved -->
              <button
                type="button"
                class="theatre-seat-unit"
                disabled
                aria-disabled="true"
                aria-label="Seat C1. Project 003: Reserved for future screening"
              >
                <div class="theatre-seat-plaque">
                  <span class="theatre-seat-id">003</span>
                  <span class="theatre-seat-num">C1</span>
                </div>
                <div class="theatre-seat-mount">
                  <span class="theatre-seat-reserved-text">RESERVED</span>
                </div>
              </button>

              <!-- Seat A2: Project 001 (Wedding Portal) -->
              <button
                type="button"
                class="theatre-seat-unit seat-art-someone"
                data-seat-id={seat001.id}
                aria-controls={`slide-${seat001.id}`}
                aria-selected="false"
                aria-label={`Seat ${seat001.seatNumber}. Screen project ${seat001.id}: ${seat001.label}`}
              >
                <div class="theatre-seat-plaque">
                  <span class="theatre-seat-id">{seat001.id}</span>
                  <span class="theatre-seat-num">{seat001.seatNumber}</span>
                </div>
                <div class="theatre-seat-mount">
                  <span class="theatre-seat-label">Courtyard Wedding</span>
                  <span class="theatre-seat-category">Memories</span>
                </div>
              </button>
            </div>

            <!-- Central Prominence: Centerpiece Seat B3 (Project 000: Studio Architecture) -->
            <button
              type="button"
              class="theatre-seat-unit seat-art-structure is-active"
              data-seat-id={seat000.id}
              aria-controls={`slide-${seat000.id}`}
              aria-selected="true"
              aria-label={`Seat ${seat000.seatNumber}. Screen project ${seat000.id}: ${seat000.label}`}
            >
              <div class="theatre-seat-plaque">
                <span class="theatre-seat-id">{seat000.id}</span>
                <span class="theatre-seat-num">{seat000.seatNumber}</span>
              </div>
              <div class="theatre-seat-mount">
                <span class="theatre-seat-label">Algoryxz Studio</span>
                <span class="theatre-seat-category">Architecture</span>
              </div>
            </button>

            <!-- Right Flank: Concept 002 & Reserved C4 -->
            <div class="theatre-seat-row-right">
              <!-- Seat A4: Project 002 (Artisan Roastery) -->
              <button
                type="button"
                class="theatre-seat-unit seat-art-business"
                data-seat-id={seat002.id}
                aria-controls={`slide-${seat002.id}`}
                aria-selected="false"
                aria-label={`Seat ${seat002.seatNumber}. Screen project ${seat002.id}: ${seat002.label}`}
              >
                <div class="theatre-seat-plaque">
                  <span class="theatre-seat-id">{seat002.id}</span>
                  <span class="theatre-seat-num">{seat002.seatNumber}</span>
                </div>
                <div class="theatre-seat-mount">
                  <span class="theatre-seat-label">Artisan Roastery</span>
                  <span class="theatre-seat-category">Specimen</span>
                </div>
              </button>

              <!-- Seat C4: Reserved -->
              <button
                type="button"
                class="theatre-seat-unit"
                disabled
                aria-disabled="true"
                aria-label="Seat C4. Project 005: Reserved for future screening"
              >
                <div class="theatre-seat-plaque">
                  <span class="theatre-seat-id">005</span>
                  <span class="theatre-seat-num">C4</span>
                </div>
                <div class="theatre-seat-mount">
                  <span class="theatre-seat-reserved-text">RESERVED</span>
                </div>
              </button>
            </div>

          </div>

          <!-- PLANE 4: Premium Rear Lodge Banquette (Conversion Anchor) -->
          <div class="theatre-lodge-terrace">
            <button
              type="button"
              class="theatre-lodge-banquette"
              data-seat-id="LODGE"
              aria-controls="slide-LODGE"
              aria-selected="false"
              aria-label="Premium Rear Lodge. Commission the next Algoryxz project."
            >
              <div class="theatre-lodge-details">
                <span class="theatre-lodge-name">REAR LODGE &middot; RESERVED FOR WHAT&rsquo;S NEXT</span>
                <span class="theatre-lodge-sub">The best seat in the house is still empty.</span>
              </div>
              <span class="theatre-lodge-badge">CLIENT SEAT</span>
            </button>
          </div>

        </div>
      </nav>

    </main>
  </div>

  <!-- ACT V: Printed Programme & Accessible Directory Drawer -->
  <aside
    class="theatre-programme-drawer"
    id="theatre-programme-drawer"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="programme-title"
  >
    <div class="theatre-programme-folio">
      <header class="theatre-folio-header">
        <div>
          <div class="theatre-folio-eyebrow">HOUSE 01 ARCHIVE</div>
          <h2 id="programme-title" class="theatre-folio-title">Tonight&rsquo;s Programme</h2>
        </div>
        <button
          type="button"
          class="theatre-folio-close"
          id="theatre-programme-close-btn"
          aria-label="Close printed programme"
        >
          &times;
        </button>
      </header>

      <!-- Active Screenings -->
      <section class="theatre-folio-section">
        <h3 class="theatre-folio-section-title">Now Screening</h3>
        <ul class="theatre-folio-list" role="list">
          {theatreSeats.filter(s => s.status !== 'RESERVED').map((s) => (
            <li>
              <a href={s.projectHref} class="theatre-folio-card" data-programme-id={s.id}>
                <div class="theatre-folio-card-meta">
                  <span class="theatre-folio-card-num">SEAT {s.seatNumber} &middot; {s.id}</span>
                  <span class="theatre-folio-card-status">{s.status}</span>
                </div>
                <strong class="theatre-folio-card-title">{s.label}</strong>
                <p class="theatre-folio-card-desc">{s.shortDescription}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Reserved Upcoming Work -->
      <section class="theatre-folio-section">
        <h3 class="theatre-folio-section-title">Reserved / Unreleased</h3>
        <ul class="theatre-folio-list" role="list">
          {reservedSeats.map((s) => (
            <li>
              <div class="theatre-folio-card theatre-folio-reserved">
                <div class="theatre-folio-card-meta">
                  <span class="theatre-folio-card-num">SEAT {s.seatNumber} &middot; {s.id}</span>
                  <span class="theatre-folio-card-status">RESERVED</span>
                </div>
                <strong class="theatre-folio-card-title">{s.label}</strong>
                <p class="theatre-folio-card-desc">{s.shortDescription}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- Rear Lodge Marquee Conversion -->
      <footer class="theatre-folio-cta-block">
        <a href="/contact" class="theatre-folio-marquee-btn">
          <span>PUT YOUR NAME ON THE NEXT MARQUEE &rarr;</span>
        </a>
      </footer>
    </div>
  </aside>
</TheatreLayout>

<script>
  // -------------------------------------------------------------
  // GATE 02: 2.5D SPATIAL CHOREOGRAPHY & SEAT-BACK ENGINE
  // -------------------------------------------------------------
  const track = document.getElementById('theatre-track');
  const stage = document.getElementById('theatre-stage');
  const beamSvg = document.getElementById('theatre-beam');
  const seatUnits = document.querySelectorAll<HTMLButtonElement>('.theatre-seat-unit:not(:disabled), .theatre-lodge-banquette');
  const slides = document.querySelectorAll<HTMLElement>('.theatre-projection-slide');
  const programmeToggle = document.getElementById('theatre-programme-btn');
  const programmeDrawer = document.getElementById('theatre-programme-drawer');
  const programmeCloseBtn = document.getElementById('theatre-programme-close-btn');

  // 1. Passive Scroll Progress Mapping (Desktop Depth Movement)
  let ticking = false;
  function updateScrollProgress() {
    if (!track || !stage) return;
    const maxScroll = track.offsetHeight - window.innerHeight;
    if (maxScroll <= 0) return;

    const currentScroll = window.scrollY;
    const progress = Math.min(Math.max(currentScroll / maxScroll, 0), 1);
    stage.style.setProperty('--scroll-p', progress.toFixed(3));
    ticking = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateScrollProgress);
        ticking = true;
      }
    },
    { passive: true }
  );

  // 2. Physical Seat Selection Engine
  function selectScreening(targetId: string) {
    // Synchronize active seat units
    seatUnits.forEach((unit) => {
      const isMatch = unit.dataset.seatId === targetId;
      unit.classList.toggle('is-active', isMatch);
      unit.setAttribute('aria-selected', String(isMatch));
    });

    // Synchronize projected screen slides
    slides.forEach((slide) => {
      const isMatch = slide.dataset.slideId === targetId;
      slide.classList.toggle('is-active', isMatch);
    });

    // Trigger subtle projector beam brightness pulse
    if (beamSvg) {
      beamSvg.classList.remove('is-pulsing');
      void beamSvg.offsetWidth; // Trigger reflow for animation restart
      beamSvg.classList.add('is-pulsing');
    }
  }

  // Bind tactile seat-back interactions (hover, focus, click)
  seatUnits.forEach((unit) => {
    const seatId = unit.dataset.seatId;
    if (!seatId) return;

    unit.addEventListener('click', () => selectScreening(seatId));
    unit.addEventListener('focus', () => selectScreening(seatId));
    unit.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') {
        selectScreening(seatId);
      }
    });
  });

  // 3. Printed Programme Drawer Controls
  function openProgramme() {
    if (!programmeDrawer || !programmeToggle) return;
    programmeDrawer.classList.add('is-open');
    programmeDrawer.setAttribute('aria-hidden', 'false');
    programmeToggle.setAttribute('aria-expanded', 'true');
    programmeCloseBtn?.focus();
  }

  function closeProgramme() {
    if (!programmeDrawer || !programmeToggle) return;
    programmeDrawer.classList.remove('is-open');
    programmeDrawer.setAttribute('aria-hidden', 'true');
    programmeToggle.setAttribute('aria-expanded', 'false');
    programmeToggle.focus();
  }

  programmeToggle?.addEventListener('click', () => {
    const isOpen = programmeDrawer?.classList.contains('is-open');
    if (isOpen) closeProgramme();
    else openProgramme();
  });

  programmeCloseBtn?.addEventListener('click', closeProgramme);

  programmeDrawer?.addEventListener('click', (e) => {
    if (e.target === programmeDrawer) closeProgramme();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && programmeDrawer?.classList.contains('is-open')) {
      closeProgramme();
    }
  });
</script>
