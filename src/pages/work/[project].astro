---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllProjects, type Project } from '../../data/projects';

export function getStaticPaths() {
  const projects = getAllProjects();
  return projects.map((p) => ({
    params: { project: p.slug },
    props: { project: p },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={`Project ${project.number} — ${project.title}`}
  description={project.shortDescription}
>
  <article class="project-detail-section section">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/work">&larr; Back to all work</a>
      </nav>

      <header class="detail-header">
        <div class="detail-meta">
          <span class="detail-num">ALGORYXZ / {project.number}</span>
          <span class:list={['badge', `badge-${project.status.toLowerCase().replace('_', '-')}`]}>
            {project.status.replace('_', ' ')}
          </span>
          <span class="detail-category">{project.category}</span>
          <span class="detail-year">{project.year}</span>
        </div>

        <h1 class="detail-title">{project.title}</h1>
        <p class="detail-lead">{project.shortDescription}</p>

        {project.liveUrl && (
          <div class="detail-actions">
            <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Visit Live Demo &nearr;
            </a>
          </div>
        )}
      </header>

      <div class="detail-hero-media">
        <img
          src={project.heroAsset}
          alt={`Hero visual for ${project.title}`}
          class="detail-hero-img"
        />
      </div>

      {project.caseStudy ? (
        <div class="case-study-body">
          <section class="cs-section">
            <h2 class="cs-heading">The Overview</h2>
            <p class="cs-text">{project.caseStudy.summary}</p>
          </section>

          <div class="cs-grid">
            <section class="cs-section">
              <h2 class="cs-heading">The Challenge</h2>
              <p class="cs-text">{project.caseStudy.challenge}</p>
            </section>

            <section class="cs-section">
              <h2 class="cs-heading">Our Solution</h2>
              <p class="cs-text">{project.caseStudy.solution}</p>
            </section>
          </div>

          <section class="cs-section">
            <h2 class="cs-heading">Key Deliverables</h2>
            <ul class="deliverables-list">
              {project.caseStudy.deliverables.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        </div>
      ) : (
        <div class="cs-placeholder">
          <p>[COPY_PENDING: Case study documentation in progress by Akriti]</p>
        </div>
      )}

      <footer class="detail-footer">
        <div class="detail-tags">
          <span class="tags-label">Technologies & Disciplines:</span>
          {project.tags.map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>
        <div class="next-steps-banner">
          <h3>Interested in a similar build?</h3>
          <p>Let's talk through scope, timeline, and exact deliverables.</p>
          <a href="/contact" class="btn btn-primary">Inquire About This Project</a>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .breadcrumb-nav {
    margin-bottom: var(--space-8);
  }

  .breadcrumb-nav a {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb-nav a:hover {
    color: var(--color-text-primary);
  }

  .detail-header {
    margin-bottom: var(--space-12);
    max-width: 840px;
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .detail-num {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    color: var(--color-accent-primary);
  }

  .detail-category,
  .detail-year {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .detail-title {
    margin-bottom: var(--space-4);
  }

  .detail-lead {
    font-size: var(--font-size-xl);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .detail-actions {
    margin-top: var(--space-6);
  }

  .detail-hero-media {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-16);
  }

  .detail-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: 800px;
  }

  .cs-heading {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-3);
  }

  .cs-text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .cs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .deliverables-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .deliverables-list li {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .deliverables-list li::before {
    content: "✓";
    color: var(--color-accent-primary);
  }

  .cs-placeholder {
    padding: var(--space-8);
    border: 1px dashed var(--color-border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-family-mono);
    color: var(--color-text-muted);
  }

  .detail-footer {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border-hairline);
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-12);
  }

  .tags-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-family: var(--font-family-mono);
    margin-right: var(--space-2);
  }

  .tag-pill {
    font-size: var(--font-size-xs);
    font-family: var(--font-family-mono);
    background-color: var(--color-bg-surface);
    color: var(--color-text-secondary);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-hairline);
  }

  .next-steps-banner {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    padding: var(--space-8);
    border-radius: var(--radius-sm);
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .next-steps-banner h3 {
    margin-bottom: var(--space-2);
  }

  .next-steps-banner p {
    margin-bottom: var(--space-6);
  }

  @media (min-width: 768px) {
    .cs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
