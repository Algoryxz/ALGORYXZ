---
import BaseLayout from '../layouts/BaseLayout.astro';
import MaterialArtifact from '../components/MaterialArtifact.astro';
import '../styles/experience.css';
---
<BaseLayout title="We make things for the internet">
 <div class="experience home-experience">
  <section class="object-track" aria-labelledby="arrival-title">
   <div class="object-room">
    <div class="room-grid" aria-hidden="true"></div>
    <div class="object-stage" aria-hidden="true"><img class="object-fallback" src="/assets/structure.svg" alt=""/><div id="fold-canvas"></div></div>
    <div class="arrival-copy"><p class="eyebrow">INDEPENDENT DESIGN & ENGINEERING / INDIA</p><h1 id="arrival-title">WE MAKE<br/>THINGS FOR<br/><span>THE INTERNET.</span></h1></div>
    <div class="arrival-bottom"><p>Brands. Businesses. People.<br/>Occasions. Weird ideas.</p><a class="text-link" href="#unfold">SCROLL TO OPEN <span>↓</span></a></div>
    <div class="unfold-copy" id="unfold"><p class="eyebrow">SAME STRUCTURE. DIFFERENT POSSIBILITIES.</p><h2>EVERYTHING<br/>STARTS WITH<br/><em>AN OPENING.</em></h2><p>A structure to hold something that matters.<br/>Then we make it yours.</p><a class="text-link" href="/work">ENTER THE ARCHIVE <span>↗</span></a></div>
    <span class="object-caption eyebrow" aria-hidden="true">XZ — A STUDY IN TENSION</span>
   </div>
  </section>
  <section class="home-materials" aria-labelledby="material-title">
   <div class="material-heading"><p class="eyebrow">THE STRUCTURE IS OURS. THE MATERIAL IS YOURS.</p><h2 id="material-title">What will<br/>you put into it?</h2><a href="/services" class="metal-link">EXPLORE THE POSSIBILITIES <span>↗</span></a></div>
   <div class="home-fragments"><a href="/services#someone" aria-label="Explore experiences for someone"><MaterialArtifact kind="someone"/></a><a href="/services#business" aria-label="Explore experiences for a business"><MaterialArtifact kind="business"/></a></div>
  </section>
 </div>
</BaseLayout>
<script>
 import { initFoldScene } from '../scripts/fold-scene';
 void initFoldScene();
</script>
<style>
.object-track{height:220vh;position:relative}.object-room{height:calc(100svh - 85px);min-height:650px;position:sticky;top:0;overflow:clip;background:radial-gradient(ellipse at 78% 46%,#30261b55,transparent 50%),#10100f}.room-grid{position:absolute;inset:0 3.4%;border-left:1px solid #ffffff06;border-right:1px solid #ffffff06}.object-stage{position:absolute;width:68%;height:112%;right:-8%;top:-7%}#fold-canvas{position:absolute;inset:0}.object-fallback{width:100%;height:100%;object-fit:contain}.object-stage[data-ready] .object-fallback{visibility:hidden}
.arrival-copy{position:absolute;top:13%;left:3.4%;z-index:2;pointer-events:none}.arrival-copy .eyebrow{margin-bottom:40px}h1{font-size:clamp(72px,9vw,155px);font-weight:600;letter-spacing:-.065em;line-height:.94}h1 span{color:#b8b0a2}.arrival-bottom{position:absolute;left:3.4%;right:3.4%;bottom:7%;display:flex;align-items:end;justify-content:space-between}.arrival-bottom p{font-size:15px;line-height:1.6;color:#b8b0a2}
.unfold-copy{position:absolute;left:3.4%;top:22%;max-width:580px;opacity:0;visibility:hidden}.unfold-copy h2{font-size:clamp(48px,6.2vw,95px);line-height:.95;letter-spacing:-.06em;margin:24px 0;font-weight:500}.unfold-copy em{font-family:Georgia,serif;color:#d8a780;font-weight:400}.unfold-copy p{font-size:14px}.unfold-copy .text-link{margin-top:20px}.object-caption{position:absolute;bottom:22%;right:8%;font-size:9px}
.home-materials{min-height:850px;padding:120px 6vw;display:grid;grid-template-columns:1fr 1.3fr;gap:6vw;overflow:clip}.material-heading h2{font-size:clamp(45px,5.5vw,85px);line-height:1;letter-spacing:-.06em;margin:30px 0 45px;font-weight:500}.home-fragments{position:relative;min-height:540px}.home-fragments a{position:absolute;width:62%;height:70%;left:0;top:0}.home-fragments a+a{left:42%;top:32%}
@media(max-width:700px){.object-track{height:190vh}.object-room{min-height:700px;height:calc(100svh - 107px)}.arrival-copy{left:20px;top:7%}.arrival-copy .eyebrow{font-size:8px;margin-bottom:22px}h1{font-size:13.4vw;line-height:.96}.object-stage{width:120%;height:68%;top:27%;right:-18%}.arrival-bottom{left:20px;right:20px;bottom:5%}.arrival-bottom p{font-size:12px}.arrival-bottom .text-link{font-size:9px;gap:15px}.object-caption{display:none}.unfold-copy{left:20px;top:7%}.unfold-copy h2{font-size:12vw}.unfold-copy p{font-size:12px}.unfold-copy .text-link{margin-top:8px;font-size:10px}.home-materials{padding:70px 20px;grid-template-columns:1fr;gap:60px}.home-fragments{min-height:470px}}
@media(prefers-reduced-motion:reduce){.object-track{height:auto}.object-room{position:relative;height:auto;min-height:auto;padding:70px 3.4vw 80px;display:grid;grid-template-columns:1.2fr 1fr;grid-template-areas:"arrival stage" "unfold stage";gap:40px 60px;align-items:start;overflow:visible}.arrival-copy{grid-area:arrival;position:relative;top:auto;left:auto;pointer-events:auto}.object-stage{grid-area:stage;position:relative;width:100%;height:520px;top:auto;right:auto;margin:0}.unfold-copy{grid-area:unfold;position:relative;top:auto;left:auto;opacity:1;visibility:visible;margin:0;max-width:580px}.arrival-bottom,.object-caption{display:none}@media(max-width:900px){.object-room{display:flex;flex-direction:column;padding:40px 20px 60px;gap:35px}.arrival-copy{order:1}.object-stage{order:2;height:280px;width:100%}.unfold-copy{order:3}}}
</style>
