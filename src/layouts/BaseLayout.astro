---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const {
  title,
  description = 'Algoryxz is an AI-native digital studio founded by Smarak, Deeptiman, and Akriti. Delivering high-craft digital experiences across Celebrations, Business & Brand, and Custom Systems.',
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://algoryxz.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO & Metadata -->
    <title>{title} | Algoryxz</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Algoryxz`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Algoryxz" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Algoryxz`} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to main content</a>
    <Navigation />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-to-content {
    position: absolute;
    top: -100px;
    left: var(--space-4);
    background: var(--color-accent-primary);
    color: var(--color-bg-canvas);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    font-weight: var(--font-weight-semibold);
    z-index: 100;
    transition: top var(--duration-fast) ease;
  }

  .skip-to-content:focus,
  .skip-to-content:focus-visible {
    top: var(--space-4);
  }

  .site-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
